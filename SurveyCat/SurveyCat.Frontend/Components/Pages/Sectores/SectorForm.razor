@using SurveyCat.Shared.Enums;

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <MudItem xs="12" Class="mb-2">
        @* d-flex y justify-space-between empujan el título a la izquierda y el input a la derecha *@
        <div class="d-flex align-center justify-space-between gap-3 pl-1">

            @* BLOQUE IZQUIERDO: Icono + Título y Subtítulo *@
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Large" />
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.h5" Color="Color.Primary">
                        <b>@(Sector?.Id != 0 ? "Editar Sector" : "Nuevo Sector")</b>
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Complete los datos requeridos para registrar/editar un Sector.
                    </MudText>
                </div>
            </div>
        </div>
        <MudDivider Class="mt-3 mb-2" DividerType="DividerType.FullWidth" />
    </MudItem>

    <MudSelect T="TipoSector" Label="Tipo de Sector"
               @bind-Value="Sector.TipoSector"
               For="@(() => Sector.TipoSector)"
               Variant="Variant.Outlined" Margin="Margin.Dense"
               AnchorOrigin="Origin.BottomCenter">
        @foreach (TipoSector item in Enum.GetValues(typeof(TipoSector)))
        {
            <MudSelectItem Value="@item">@item.ToString()</MudSelectItem>
        }
    </MudSelect>

    <MudTextField Label="Número de Sector"
                  @bind-Value="@Sector.NumeroSector"
                  For="@(() => Sector.NumeroSector)"
                  Required="true"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Class="mb-4" />

    <MudTextField Label="Cod. Sector-Departamento"
                  @bind-Value="@Sector.SectorDepto"
                  For="@(() => Sector.SectorDepto)"
                  Required="true"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Class="mb-4" />

    <MudTextField Label="Cod. Sector-Sector"
                  @bind-Value="@Sector.SectorMuni"
                  For="@(() => Sector.SectorMuni)"
                  Required="true"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Class="mb-4" />

    <div class="d-flex justify-end gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ReturnAction">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Guardar</MudButton>
    </div>
</EditForm>
