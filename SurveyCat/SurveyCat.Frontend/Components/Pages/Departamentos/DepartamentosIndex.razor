@page "/departamentos"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Departamentos"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <div class="d-flex justify-content-between">
                <MudText Typo="Typo.h6" Class="me-4">DEPARTAMENTOS</MudText>
                <MudButton Variant="Variant.Outlined"
                           EndIcon="@Icons.Material.Filled.Add"
                           Color="Color.Info" OnClick="@(() => ShowModalAsync())">
                    Nuevo
                </MudButton>
            </div>
            <MudSpacer />
            <FilterComponent @bind-FilterValue="Filter" ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Departamento</MudTh>
            <MudTh Style="width: 20%;">Cod. SILEC</MudTh>
            <MudTh Style="width: 20%;">Municipios</MudTh>
            <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Departamento">@context.Nombre</MudTd>
            <MudTd DataLabel="Cod. SILEC">@context.CodDepto</MudTd>
            <MudTd DataLabel="Municipios">
                <MudTooltip Text="Ver Municipios">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Medium"
                               OnClick="@(() => StatesAction(@context))"
                               Style="width: 70px; min-width: 70px; color: #4682B4; border-color: #4682B4;"
                               Class="d-flex justify-space-between px-2">

                        <span>@context.MunicipiosNumber</span>

                        <MudIcon Icon="@Icons.Material.TwoTone.ArrowCircleRight"
                                 Size="Size.Small"
                                 Class="ml-2" />
                    </MudButton>
                </MudTooltip>
            </MudTd>

            <MudTd DataLabel="Acciones" Style="text-align: center; white-space: nowrap;">
                <div class="d-flex justify-center">
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       OnClick="@(() => ShowModalAsync(context.Id, true))"
                                       Size="Size.Medium"
                                       Class="mr-2" />
                    </MudTooltip>
                    <MudTooltip Text="Borrar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context))"
                                       Size="Size.Medium" />
                    </MudTooltip>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>"No hay registros"</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat" />
        </PagerContent>
    </MudTable>
}

