<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <MudTextField Label="Departamento"
                    @bind-Value="@Departamento.Nombre"
                    For="@(() => Departamento.Nombre)"
                    Class="mb-4" />
    <MudTextField Label="Cod. SILEC"
                    @bind-Value="@Departamento.CodDepto"
                    For="@(() => Departamento.CodDepto)"
                    Class="mb-4" />

    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Color="Color.Info"
               OnClick="ReturnAction">
        <MudHidden xs="true">
            Cancelar
        </MudHidden>
    </MudButton>

    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Check"
               Color="Color.Primary"
               ButtonType="ButtonType.Submit">
        <MudHidden xs="true">
            Guardar
        </MudHidden>
    </MudButton>
</EditForm>
