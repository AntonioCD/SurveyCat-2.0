@page "/departamento/details/{DepartamentoId:int}"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@municipios"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6" Class="mr-4"><i class="bi bi-globe-americas"></i> @departamento?.Nombre</MudText>
            <MudButton Variant="Variant.Outlined" Class="mr-4" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Tertiary" OnClick="ReturnAction">Regresar</MudButton>
            <MudButton Variant="Variant.Outlined" Class="mr-4" EndIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="@(() => ShowModalAsync())">Crear</MudButton>
            <MudSpacer />
            <FilterComponent ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Municipio</MudTh>
            <MudTh Style="width: 20%;">Cod. SILEC</MudTh>
            <MudTh Style="width: 20%;">Barrios/Comarcas</MudTh>
            <MudTh Style="width: 20%;">Sectores</MudTh>
            <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Municipio">@context.Nombre</MudTd>
            <MudTd DataLabel="Cod. SILEC">@context.CodMuni</MudTd>
            <MudTd DataLabel="Barrios/Comarcas">
                <MudTooltip Text="Ver Barrios/Comarcas">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Medium"
                               OnClick="@(() => StatesAction(@context))"
                               Style="width: 70px; min-width: 70px; color: #4682B4; border-color: #4682B4;"
                               Class="d-flex justify-space-between px-2">

                        <span>@context.BarriosComarcasNumber</span>

                        <MudIcon Icon="@Icons.Material.TwoTone.ArrowCircleRight"
                                 Size="Size.Small"
                                 Class="ml-2" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Sectores">
                <MudTooltip Text="Ver Sectores">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Medium"
                               OnClick="@(() => SectoresAction(@context))"
                               Style="width: 70px; min-width: 70px; color: #4682B4; border-color: #4682B4;"
                               Class="d-flex justify-space-between px-2">

                        <span>@context.SectoresNumber</span>

                        <MudIcon Icon="@Icons.Material.TwoTone.ArrowCircleRight"
                                 Size="Size.Small"
                                 Class="ml-2" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: center; white-space: nowrap;">
                <div class="d-flex justify-center">
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       OnClick="@(() => ShowModalAsync(context.Id, true))"
                                       Size="Size.Medium"
                                       Class="mr-2" />
                    </MudTooltip>
                    <MudTooltip Text="Borrar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context))"
                                       Size="Size.Medium" />
                    </MudTooltip>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No se encontraron registros.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Numero de Registros:"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todos"
                           InfoFormat="@infoFormat" />
        </PagerContent>
    </MudTable>
}



