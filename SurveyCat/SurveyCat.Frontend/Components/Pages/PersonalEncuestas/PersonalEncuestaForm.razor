@using SurveyCat.Shared.Enums;
@using SurveyCat.Shared.Entities

<MudItem xs="12" Class="mb-2">
    @* d-flex y justify-space-between empujan el título a la izquierda y el input a la derecha *@
    <div class="d-flex align-center justify-space-between gap-3 pl-1">

        @* BLOQUE IZQUIERDO: Icono + Título y Subtítulo *@
        <div class="d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Large" />
            <div class="d-flex flex-column">
                <MudText Typo="Typo.h5" Color="Color.Primary">
                    <b>@(PersonalEncuesta?.Id != 0 ? "Editar Personal de Encuesta" : "Nuevo Personal de Encuesta")</b>
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Complete los datos requeridos para registrar/editar un Personal de Encuesta.
                </MudText>
            </div>
        </div>
    </div>
    <MudDivider Class="mt-3 mb-2" DividerType="DividerType.FullWidth" />
</MudItem>

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <MudGrid>
        <MudItem xs="12">
            @if(PersonalEncuesta?.Id == 0) {
                <MudButton Variant = "Variant.Outlined"
                    EndIcon = "@Icons.Material.Filled.PersonSearch"
                    Color = "Color.Info" OnClick = "@(() => ShowModalPersonaSearchAsync())" >
                    Buscar Persona
                </MudButton >
            }

            @if (PersonalEncuesta!.PersonaId == 0)
            {
                @* Si es 0, el input existe, está vacío y es 'required', disparando el globo *@
                <input @key="PersonalEncuesta.PersonaId"
                       type="text"
                       value=""
                       required
                       oninvalid="this.setCustomValidity('Debe buscar y seleccionar una persona.')"
                       oninput="this.setCustomValidity('')"
                       style="opacity: 0; width: 1px; height: 1px; position: absolute; pointer-events: none;" />
            }
            else
            {
                @* Si es mayor a 0, renderizamos un input con valor lleno y SIN 'required' *@
                <input @key="PersonalEncuesta.PersonaId"
                       type="text"
                       value="@PersonalEncuesta.PersonaId"
                       style="opacity: 0; width: 1px; height: 1px; position: absolute; pointer-events: none;" />
            }
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudTextField Label="Primer Nombre"
                          Variant="Variant.Filled"
                          @bind-Value="persona!.PrimerNombre"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudTextField Label="Segundo Nombre"
                          Variant="Variant.Filled"
                          @bind-Value="persona!.SegundoNombre"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudTextField Label="Primer Apellido"
                          Variant="Variant.Filled"
                          @bind-Value="persona!.PrimerApellido"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudTextField Label="Segundo Apellido"
                          Variant="Variant.Filled"
                          @bind-Value="persona!.SegundoApellido"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudTextField Label="Identificación"
                          Variant="Variant.Filled"
                          @bind-Value="persona!.Identificacion"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudTextField Label="Genero"
                          Variant="Variant.Filled"
                          @bind-Value="persona!.Genero"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudNumericField Label="Edad"
                             Variant="Variant.Filled"
                             @bind-Value="persona!.Edad"
                             Margin="Margin.Dense"
                             ReadOnly="true" />
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudTextField Label="Estado Civil"
                          Variant="Variant.Filled"
                          Value="@(persona?.EstadoCivil?.Nombre ?? string.Empty)"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField Label="Profesión u Oficio"
                          Variant="Variant.Filled"
                          Value="@(persona?.Profesion?.Nombre ?? string.Empty)"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudTextField Label="Departamento"
                          Variant="Variant.Filled"
                          Value="@(persona?.Municipio?.Departamento?.Nombre ?? string.Empty)"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudTextField Label="Municipio"
                          Variant="Variant.Filled"
                          Value="@(persona?.Municipio?.Nombre ?? string.Empty)"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudTextField Label="Barrio/Comarca"
                          Variant="Variant.Filled"
                          Value="@(persona?.BarrioComarca?.Nombre ?? string.Empty)"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12" sm="3">
            <MudTextField Label="Caserío"
                          Variant="Variant.Filled"
                          Value="@(persona?.Caserio?.Nombre ?? string.Empty)"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField Label="Dirección Domiciliar"
                          Variant="Variant.Filled"
                          @bind-Value="persona!.Direccion"
                          Margin="Margin.Dense"
                          ReadOnly="true" />
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.h6" Class="deep-purple-text"><b>DATOS GENERALES</b></MudText>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudTextField Label="Código de Técnico"
                          @bind-Value="PersonalEncuesta.Codigo"
                          @bind-Value:after="() => PersonalEncuesta.Codigo = PersonalEncuesta.Codigo.ToUpper()"
                          Immediate="true"
                          For="@(() => PersonalEncuesta.Codigo)" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudTextField Label="Código de Brigada"
                          @bind-Value="PersonalEncuesta.Brigada"
                          @bind-Value:after="() => PersonalEncuesta.Brigada = PersonalEncuesta.Brigada.ToUpper()"
                          Immediate="true"
                          For="@(() => PersonalEncuesta.Brigada)" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12">
            <MudSelect T="TipoRol" Label="Rol"
                       @bind-Value="PersonalEncuesta.TipoRol"
                       For="@(() => PersonalEncuesta.TipoRol)"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       AnchorOrigin="Origin.BottomCenter">
                @foreach (TipoRol item in Enum.GetValues(typeof(TipoRol)))
                {
                    <MudSelectItem Value="@item">@item.ToString()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" class="d-flex justify-end gap-2 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ReturnAction">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Guardar</MudButton>
        </MudItem>

    </MudGrid>
</EditForm>


