@page "/ocupantes/batch-create/{FichaId:int}"
@using SurveyCat.Shared.Entities
@using SurveyCat.Shared.Enums

<MudItem xs="12" Class="mb-4">
    <div class="d-flex align-center justify-space-between gap-3 pl-1">
        <div class="d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Color="Color.Primary" Size="Size.Large" />
            <div class="d-flex flex-column">
                <MudText Typo="Typo.h5" Color="Color.Primary">
                    <b>Carga Rápida de Ocupantes</b>
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Agregue las personas que habitan en la propiedad y defina sus roles/parentescos antes de guardar.
                </MudText>
            </div>
        </div>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.PersonSearch"
                   OnClick="BuscarYAgregarPersonaAsync"
                   Disabled="loading">
            Agregar Persona
        </MudButton>
    </div>
    <MudDivider Class="mt-3" DividerType="DividerType.FullWidth" />
</MudItem>

<!-- TABLA DE CAPTURA RÁPIDA -->
<MudPaper Outlined="true" Class="pa-4 mb-4" Style="border-radius: 8px;">
    <div class="d-flex align-center justify-space-between mb-3">
        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-2" />
            <b>Lista de Ocupantes a Registrar (@listaOcupantesVM.Count)</b>
        </MudText>
    </div>

    @if (!listaOcupantesVM.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-2">
            No se han agregado personas a la lista. Haga clic en <b>"Agregar Persona"</b> para comenzar.
        </MudAlert>
    }
    else
    {
        <MudTable Items="listaOcupantesVM"
                  Hover="true"
                  Outlined="true"
                  Dense="true"
                  Elevation="0"
                  Class="mb-2">
            <HeaderContent>
                <MudTh Style="width: 50px;">#</MudTh>
                <MudTh Style="min-width: 250px;">Persona / Datos Personales</MudTh>
                <MudTh Style="min-width: 200px;">Tipo de Ocupante *</MudTh>
                <MudTh Style="min-width: 200px;">Parentesco</MudTh>
                <MudTh Style="width: 80px;" Class="text-center">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <!-- # NÚMERO -->
                <MudTd DataLabel="#">
                    <MudText Typo="Typo.body2"><b>@(listaOcupantesVM.IndexOf(context) + 1)</b></MudText>
                </MudTd>

                <!-- DATOS DE LA PERSONA -->
                <MudTd DataLabel="Persona">
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.body2">
                            <b>@context.Persona.NombreCompleto</b>
                        </MudText>
                        <div class="d-flex align-center gap-2 mt-1">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Dark" Class="ma-0">
                                Identificación: @(string.IsNullOrWhiteSpace(context.Persona.Identificacion) ? "N/D" : context.Persona.Identificacion)
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="ma-0">
                                @context.Persona.Genero | @context.Persona.Edad años
                            </MudChip>
                        </div>
                    </div>
                </MudTd>

                <!-- TIPO DE OCUPANTE -->
                <MudTd DataLabel="Tipo de Ocupante">
                    <MudSelect T="Diccionario"
                               Value="context.TipoOcupante"
                               ValueChanged="@((val) => OnTipoOcupanteChanged(context, val))"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Placeholder="-- Seleccione --">
                        @foreach (var tipo in listaTipoOcupante)
                        {
                            <MudSelectItem Value="@tipo">@tipo.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>

                <!-- PARENTESCO -->
                <MudTd DataLabel="Parentesco">
                    <MudSelect T="Diccionario"
                               Value="context.Parentesco"
                               ValueChanged="@((val) => context.Parentesco = val)"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true"
                               Disabled="@(!EsFamiliar(context))"
                               Placeholder="@(EsFamiliar(context) ? "-- Seleccione --" : "N/A")">
                        @foreach (var parentesco in listaParentesco)
                        {
                            <MudSelectItem Value="@parentesco">@parentesco.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudTd>

                <!-- ACCIONES -->
                <MudTd DataLabel="Acciones" Class="text-center">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => RemoverOcupante(context))"
                                   Title="Remover de la lista" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<!-- BOTONES DE ACCIÓN -->
<div class="d-flex justify-end gap-3 mt-4 mb-2">
    <MudButton Variant="Variant.Filled"
               Color="Color.Secondary"
               OnClick="Return"
               Disabled="guardando">
        Cancelar
    </MudButton>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="GuardarTodosAsync"
               Disabled="!listaOcupantesVM.Any() || guardando">
        @if (guardando)
        {
            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
            <MudText Class="ms-2">Guardando...</MudText>
        }
        else
        {
            <span>Guardar Todos (@listaOcupantesVM.Count)</span>
        }
    </MudButton>
</div>