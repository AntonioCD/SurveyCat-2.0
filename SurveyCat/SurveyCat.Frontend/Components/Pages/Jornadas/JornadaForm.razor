<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <MudItem xs="12" Class="mb-2">
        @* d-flex y justify-space-between empujan el título a la izquierda y el input a la derecha *@
        <div class="d-flex align-center justify-space-between gap-3 pl-1">

            @* BLOQUE IZQUIERDO: Icono + Título y Subtítulo *@
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Large" />
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.h5" Color="Color.Primary">
                        <b>@(Jornada?.Id != 0 ? "Editar Jornada" : "Nueva Jornada")</b>
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Complete los datos requeridos para registrar/editar una Jornada.
                    </MudText>
                </div>
            </div>
        </div>
        <MudDivider Class="mt-3 mb-2" DividerType="DividerType.FullWidth" />
    </MudItem>

    <MudGrid Class="align-center">
        <MudItem xs="12" >
            <MudTextField Label="Código Jornada"
                          @bind-Value="@Jornada.CodJornada"
                          For="@(() => Jornada.CodJornada)"
                          Required="true"
                          MaxLength="3"
                          Pattern="[0-9]*"
                          InputMode="InputMode.numeric"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField Label="Nombre de la Jornada"
                          @bind-Value="@Jornada.Nombre"
                          For="@(() => Jornada.Nombre)"
                          Required="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12" >
            <MudDatePicker Label="Fecha de Inicio"
                           @bind-Date="Jornada.FechaInicio"
                           For="@(() => Jornada.FechaInicio)"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Editable="true" />
        </MudItem>

        <MudItem xs="12" >
            <MudDatePicker Label="Fecha de Fin"
                           @bind-Date="Jornada.FechaFin"
                           For="@(() => Jornada.FechaFin)"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Editable="true" />
        </MudItem>

        <MudItem xs="12" Class="d-flex justify-center">
            <MudSwitch @bind-Value="@Jornada.Activo"
                       Label="@(Jornada.Activo ? "Activo" : "Inactivo")"
                       Color="Color.Primary"
                       UncheckedColor="Color.Secondary"
                       ThumbIcon="@(Jornada.Activo? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
                       Class="mb-4" />
        </MudItem>
    </MudGrid>
   
   

    


    <div class="d-flex justify-end gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ReturnAction">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Guardar</MudButton>
    </div>
</EditForm>
