@using SurveyCat.Shared.Enums;
@using SurveyCat.Shared.Entities
@using System.ComponentModel.DataAnnotations

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    @if (editContext?.GetValidationMessages().Any() == true)
    {
        <MudPaper Class="validation-summary-custom pa-3" Elevation="1">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2" Color="Color.Error">
                    <b>Corrige los siguientes errores:</b>
                </MudText>
            </div>
            <ul>
                @foreach (var message in editContext.GetValidationMessages())
                {
                    <li>@message</li>
                }
            </ul>
        </MudPaper>
    }

    <MudGrid>
        <MudItem xs="12" Class="mb-2">
            <div class="d-flex align-center justify-space-between gap-3 pl-1">
                <div class="d-flex align-center gap-3">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Secondary"
                                   OnClick="ReturnAction"
                                   Title="Regresar"
                                   Size="Size.Large"
                                   Class="mr-1" />
                    <MudIcon Icon="@Icons.Material.Filled.CreateNewFolder" Color="Color.Primary" Size="Size.Large" />
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h5" Color="Color.Primary">
                            <b>@(Ficha?.Id != 0 ? "Editar Ficha" : "Nueva Ficha")</b>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Complete los datos requeridos para registrar/editar una encuesta catastral.
                        </MudText>
                    </div>
                </div>
                <div style="width: 240px;">
                    <MudTextField Label="CÓDIGO DE ENCUESTA"
                                  @bind-Value="Ficha.CodEncuesta"
                                  Immediate="true"
                                  For="@(() => Ficha.CodEncuesta)"
                                  Variant="Variant.Filled"
                                  Margin="Margin.None"
                                  ReadOnly="true"
                                  Style="font-size: 1.3rem !important; color: #0B74F4 !important;" />
                </div>
            </div>
            <MudDivider Class="mt-3 mb-0" DividerType="DividerType.FullWidth" />
        </MudItem>

        <MudItem xs="12">
            <MudTabs Elevation="1"
                     Centered="true"
                     Color="Color.Primary"
                     @bind-ActivePanelIndex="activeTabIndex">

                <!-- TAB 1: Datos de la Ficha -->
                <MudTabPanel Text="Datos de la Ficha"
                             Icon="@Icons.Material.Filled.Description"
                             IconColor="Color.Default">
                    <div class="pa-10">
                        <MudGrid>
                            <!-- Datos Generales -->
                            <MudPaper Class="mb-4" Elevation="0" Outlined="true" Style="border-radius: 8px; overflow: hidden; width: 100%;">
                                <div class="section-header">
                                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" Size="Size.Small" />
                                    <MudText>Datos Generales</MudText>
                                    @if (loading)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="ml-3" />
                                    }
                                </div>
                                <div class="pa-4">
                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="Departamento"
                                                             Label="Departamento"
                                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un Departamento --")"
                                                             SearchFunc="SearchDepartamento"
                                                             Value="selectedDepartamento"
                                                             ValueChanged="DepartamentoChangedAsync"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Disabled="loading"
                                                             Required="true"
                                                             RequiredError="El Departamento es requerido."
                                                             For="@(() => selectedDepartamento)"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceText="false"
                                                             CoerceValue="false"
                                                             ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                                <ItemTemplate Context="itemContext">
                                                    @itemContext.Nombre
                                                </ItemTemplate>
                                            </MudAutocomplete>
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="Municipio"
                                                             Label="Municipio"
                                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un Municipio --")"
                                                             SearchFunc="SearchMunicipio"
                                                             Value="selectedMunicipio"
                                                             ValueChanged="MunicipioChangedAsync"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Disabled="loading"
                                                             Required="true"
                                                             RequiredError="El Municipio es requerido."
                                                             For="@(() => selectedMunicipio)"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceText="false"
                                                             CoerceValue="false"
                                                             ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                                <ItemTemplate Context="itemContext">
                                                    @itemContext.Nombre
                                                </ItemTemplate>
                                            </MudAutocomplete>
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="Sector"
                                                             Label="Sector"
                                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un Sector --")"
                                                             SearchFunc="SearchSector"
                                                             Value="selectedSector"
                                                             ValueChanged="SectorChanged"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Disabled="loading"
                                                             Required="true"
                                                             RequiredError="El Sector es requerido."
                                                             For="@(() => selectedSector)"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceText="false"
                                                             CoerceValue="false"
                                                             ToStringFunc="@(e => e == null ? null : $"{e.NumeroSector}")">
                                                <ItemTemplate Context="itemContext">
                                                    @itemContext.NumeroSector
                                                </ItemTemplate>
                                            </MudAutocomplete>
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudTextField Label="Consecutivo"
                                                          @bind-Value="Ficha.Consecutivo"
                                                          OnBlur="GenerarCodigoEncuesta"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Disabled="loading"
                                                          Required="true"
                                                          RequiredError="El número consecutivo es requerido."
                                                          For="@(() => Ficha.Consecutivo)"
                                                          InputType="InputType.Number"
                                                          MaxLength="4"
                                                          Placeholder="Ej: 0001" />
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            </MudPaper>

                            <!-- Datos del Personal -->
                            <MudPaper Class="mb-4" Elevation="0" Outlined="true" Style="border-radius: 8px; overflow: hidden; width: 100%;">
                                <div class="section-header">
                                    <MudIcon Icon="@Icons.Material.Filled.AccessibilityNew" Color="Color.Primary" Size="Size.Small" />
                                    <MudText>Datos del Personal</MudText>
                                    @if (loading)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="ml-3" />
                                    }
                                </div>
                                <div class="pa-4">
                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="PersonalEncuesta"
                                                             Label="Encuestador"
                                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un Encuestador --")"
                                                             SearchFunc="SearchEncuestador"
                                                             Value="selectedEncuestador"
                                                             ValueChanged="EncuestadorChanged"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Disabled="loading"
                                                             Required="true"
                                                             RequiredError="El Encuestador es requerido."
                                                             For="@(() => selectedEncuestador)"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceText="false"
                                                             CoerceValue="false"
                                                             ToStringFunc="@(e => e == null ? null : $"{e.Persona?.NombreCompleto}")">
                                                <ItemTemplate Context="itemContext">
                                                    @itemContext.Persona?.NombreCompleto
                                                </ItemTemplate>
                                            </MudAutocomplete>
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="PersonalEncuesta"
                                                             Label="Técnico Catastral"
                                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un Técnico Catastral --")"
                                                             SearchFunc="SearchTecnicoCatastral"
                                                             Value="selectedTecnicoCatastral"
                                                             ValueChanged="TecnicoCatastralChanged"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Disabled="loading"
                                                             Required="true"
                                                             RequiredError="El Técnico es requerido."
                                                             For="@(() => selectedTecnicoCatastral)"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceText="false"
                                                             CoerceValue="false"
                                                             ToStringFunc="@(e => e == null ? null : $"{e.Persona?.NombreCompleto}")">
                                                <ItemTemplate Context="itemContext">
                                                    @itemContext.Persona?.NombreCompleto
                                                </ItemTemplate>
                                            </MudAutocomplete>
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudAutocomplete T="PersonalEncuesta"
                                                             Label="Jefe de Campo"
                                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un Jefe de Campo --")"
                                                             SearchFunc="SearchSupervisor"
                                                             Value="selectedSupervisor"
                                                             ValueChanged="SupervisorChanged"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Disabled="loading"
                                                             Required="true"
                                                             RequiredError="El Jefe de Campo es requerido."
                                                             For="@(() => selectedSupervisor)"
                                                             ResetValueOnEmptyText="true"
                                                             CoerceText="false"
                                                             CoerceValue="false"
                                                             ToStringFunc="@(e => e == null ? null : $"{e.Persona?.NombreCompleto}")">
                                                <ItemTemplate Context="itemContext">
                                                    @itemContext.Persona?.NombreCompleto
                                                </ItemTemplate>
                                            </MudAutocomplete>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            </MudPaper>

                            <!-- Datos del Inmueble -->
                            <MudPaper Class="mb-4" Elevation="0" Outlined="true" Style="border-radius: 8px; overflow: hidden;">
                                <div class="section-header">
                                    <MudIcon Icon="@Icons.Material.Filled.Domain" Color="Color.Primary" Size="Size.Small" />
                                    <MudText>Datos del Inmueble</MudText>
                                    @if (loading)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="ml-3" />
                                    }
                                </div>
                                <div class="pa-4">
                                    <MudGrid>
                                        <MudItem xs="12" sm="6" style="position: relative;">
                                            <MudSelect T="TipoEncuesta" Label="Tipo de Parcela"
                                                       @bind-Value="Ficha.TipoEncuesta"
                                                       For="@(() => Ficha.TipoEncuesta)"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       AnchorOrigin="Origin.BottomCenter"
                                                       Disabled="loading"
                                                       Required="true"
                                                       Validation="@(new RangeAttribute(1, int.MaxValue) { ErrorMessage = "Seleccione un Tipo de Parcela." })">

                                                @foreach (TipoEncuesta item in Enum.GetValues(typeof(TipoEncuesta)))
                                                {
                                                    <MudSelectItem Value="@item">
                                                        @((int)item == 0 ? "-- Seleccione un Tipo --" : item.ToString())
                                                    </MudSelectItem>
                                                }
                                            </MudSelect>

                                            @if ((int)Ficha.TipoEncuesta == 0)
                                            {
                                                <input @key="@((int)Ficha.TipoEncuesta)"
                                                       type="text"
                                                       value=""
                                                       required
                                                       oninvalid="this.setCustomValidity('Seleccione un Tipo de Parcela.')"
                                                       oninput="this.setCustomValidity('')"
                                                       style="opacity: 0; width: 100%; height: 1px; position: absolute; bottom: 0; left: 0; pointer-events: none;" />
                                            }
                                            else
                                            {
                                                <input @key="@((int)Ficha.TipoEncuesta)"
                                                       type="text"
                                                       value="@((int)Ficha.TipoEncuesta)"
                                                       style="opacity: 0; width: 100%; height: 1px; position: absolute; bottom: 0; left: 0; pointer-events: none;" />
                                            }
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudTextField Label="Nombre de la Finca"
                                                          @bind-Value="Ficha.NombreFinca"
                                                          OnBlur="@(() => Ficha.NombreFinca = Ficha.NombreFinca?.ToUpper())"
                                                          Immediate="true"
                                                          For="@(() => Ficha.NombreFinca)"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Disabled="loading" />
                                        </MudItem>

                                        <!-- Ubicación -->
                                        <MudItem xs="12">
                                            <MudPaper Class="pa-4" Elevation="0" Outlined="true" Style="border-radius: 8px;">
                                                <MudText Typo="Typo.subtitle2" Class="mb-3" Color="Color.Primary" Style="text-align:center">
                                                    Ubicación
                                                </MudText>
                                                <MudGrid>
                                                    <MudItem xs="12" sm="6">
                                                        <MudAutocomplete T="BarrioComarca"
                                                                         Label="Barrio/Comarca"
                                                                         Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un Barrio/Comarca --")"
                                                                         SearchFunc="SearchBarrioComarca"
                                                                         Value="selectedBarrioComarca"
                                                                         ValueChanged="BarrioComarcaChangedAsync"
                                                                         Variant="Variant.Outlined"
                                                                         Margin="Margin.Dense"
                                                                         Disabled="loading"
                                                                         ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                                            <ItemTemplate Context="itemContext">
                                                                @itemContext.Nombre
                                                            </ItemTemplate>
                                                        </MudAutocomplete>
                                                    </MudItem>

                                                    <MudItem xs="12" sm="6">
                                                        <MudAutocomplete T="Caserio"
                                                                         Label="Caserio"
                                                                         Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un Caserio --")"
                                                                         SearchFunc="SearchCaserio"
                                                                         Value="selectedCaserio"
                                                                         ValueChanged="CaserioChanged"
                                                                         Variant="Variant.Outlined"
                                                                         Margin="Margin.Dense"
                                                                         Disabled="loading"
                                                                         ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                                            <ItemTemplate Context="itemContext">
                                                                @itemContext.Nombre
                                                            </ItemTemplate>
                                                        </MudAutocomplete>
                                                    </MudItem>

                                                    <MudItem xs="12" sm="6">
                                                        <MudTextField Label="Manzana"
                                                                      @bind-Value="Ficha.Manzana"
                                                                      OnBlur="@(() => Ficha.Manzana = Ficha.Manzana?.ToUpper())"
                                                                      Immediate="true"
                                                                      For="@(() => Ficha.Manzana)"
                                                                      Variant="Variant.Outlined"
                                                                      Margin="Margin.Dense"
                                                                      Disabled="loading" />
                                                    </MudItem>

                                                    <MudItem xs="12" sm="6">
                                                        <MudTextField Label="Lote"
                                                                      @bind-Value="Ficha.Lote"
                                                                      OnBlur="@(() => Ficha.Lote = Ficha.Lote?.ToUpper())"
                                                                      Immediate="true"
                                                                      For="@(() => Ficha.Lote)"
                                                                      Variant="Variant.Outlined"
                                                                      Margin="Margin.Dense"
                                                                      Disabled="loading" />
                                                    </MudItem>

                                                    <MudItem xs="12">
                                                        <MudTextField Label="Dirección"
                                                                      @bind-Value="Ficha.Direccion"
                                                                      Variant="Variant.Outlined"
                                                                      Margin="Margin.Dense"
                                                                      Disabled="loading" />
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudSelect T="TipoUsoParcela?" Label="Tipo de Uso"
                                                       @bind-Value="Ficha.TipoUso"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Clearable="true"
                                                       Disabled="loading"
                                                       Placeholder="Seleccione">
                                                @foreach (TipoUsoParcela item in Enum.GetValues(typeof(TipoUsoParcela)))
                                                {
                                                    <MudSelectItem Value="@((TipoUsoParcela?)item)">@item.ToString()</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudTextField Label="Descripción"
                                                          @bind-Value="Ficha.DescripcionTipoUso"
                                                          OnBlur="@(() => Ficha.DescripcionTipoUso = Ficha.DescripcionTipoUso?.ToUpper())"
                                                          Immediate="true"
                                                          For="@(() => Ficha.DescripcionTipoUso)"
                                                          Variant="Variant.Outlined"
                                                          Margin="Margin.Dense"
                                                          Disabled="loading" />
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudNumericField Label="Area Estimada"
                                                             @bind-Value="Ficha.AreaEstimada"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Disabled="loading" />
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="Diccionario"
                                                             Label="Unidad de Medida"
                                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione una UDM --")"
                                                             SearchFunc="SearchUnidadMedida"
                                                             Value="selectedUnidadMedida"
                                                             ValueChanged="UnidadMedidaChanged"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Disabled="loading"
                                                             ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                                <ItemTemplate Context="itemContext">
                                                    @itemContext.Nombre
                                                </ItemTemplate>
                                            </MudAutocomplete>
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudAutocomplete T="Diccionario"
                                                             Label="Origen de la Tierra"
                                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione el Origen --")"
                                                             SearchFunc="SearchOrigenTierra"
                                                             Value="selectedOrigenTierra"
                                                             ValueChanged="OrigenTierraChanged"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Disabled="loading"
                                                             ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                                <ItemTemplate Context="itemContext">
                                                    @itemContext.Nombre
                                                </ItemTemplate>
                                            </MudAutocomplete>
                                        </MudItem>

                                        <!-- Servidumbre -->
                                        <MudItem xs="12">
                                            <MudPaper Class="pa-4" Elevation="0" Outlined="true" Style="border-radius: 8px;">
                                                <MudText Typo="Typo.subtitle2" Class="mb-3" Color="Color.Primary" Style="text-align:center">
                                                    Servidumbre
                                                </MudText>
                                                <MudGrid>
                                                    <MudItem xs="12" sm="6" Class="d-flex justify-left">
                                                        <MudCheckBox Label="¿Posee Servidumbre?"
                                                                     @bind-Value="Ficha.Servidumbre"
                                                                     Color="Color.Primary"
                                                                     Disabled="loading"
                                                                     For="@(() => Ficha.Servidumbre)" />
                                                    </MudItem>

                                                    <MudItem xs="12" sm="6">
                                                        <MudAutocomplete T="Diccionario"
                                                                         Label="Servidumbre de Agua"
                                                                         Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un tipo --")"
                                                                         SearchFunc="SearchServidumbreAgua"
                                                                         Value="selectedServidumbreAgua"
                                                                         ValueChanged="ServidumbreAguaChanged"
                                                                         Variant="Variant.Outlined"
                                                                         Margin="Margin.Dense"
                                                                         Disabled="loading"
                                                                         ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                                            <ItemTemplate Context="itemContext">
                                                                @itemContext.Nombre
                                                            </ItemTemplate>
                                                        </MudAutocomplete>
                                                    </MudItem>

                                                    <MudItem xs="12" sm="6">
                                                        <MudAutocomplete T="Diccionario"
                                                                         Label="Servidumbre de Pase"
                                                                         Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un tipo --")"
                                                                         SearchFunc="SearchServidumbrePase"
                                                                         Value="selectedServidumbrePase"
                                                                         ValueChanged="ServidumbrePaseChanged"
                                                                         Variant="Variant.Outlined"
                                                                         Margin="Margin.Dense"
                                                                         Disabled="loading"
                                                                         ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                                            <ItemTemplate Context="itemContext">
                                                                @itemContext.Nombre
                                                            </ItemTemplate>
                                                        </MudAutocomplete>
                                                    </MudItem>

                                                    <MudItem xs="12" sm="6">
                                                        <MudAutocomplete T="Diccionario"
                                                                         Label="Servidumbre (Otra)"
                                                                         Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un tipo --")"
                                                                         SearchFunc="SearchServidumbreOtra"
                                                                         Value="selectedServidumbreOtra"
                                                                         ValueChanged="ServidumbreOtraChanged"
                                                                         Variant="Variant.Outlined"
                                                                         Margin="Margin.Dense"
                                                                         Disabled="loading"
                                                                         ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                                            <ItemTemplate Context="itemContext">
                                                                @itemContext.Nombre
                                                            </ItemTemplate>
                                                        </MudAutocomplete>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            </MudPaper>

                            <!-- Datos del Entrevistado -->
                            <MudPaper Class="mb-0" Elevation="0" Outlined="true" Style="border-radius: 8px; overflow: hidden;">
                                <div class="section-header">
                                    <MudIcon Icon="@Icons.Material.Filled.SpatialAudioOff" Color="Color.Primary" Size="Size.Small" />
                                    <MudText>Datos del Entrevistado</MudText>
                                    @if (loading)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="ml-3" />
                                    }
                                </div>
                                <div class="pa-4">
                                    <MudGrid>
                                        <MudItem xs="12">
                                            <MudButton Variant="Variant.Outlined"
                                                       EndIcon="@Icons.Material.Filled.PersonSearch"
                                                       Color="Color.Info"
                                                       Disabled="loading"
                                                       OnClick="@(() => ShowModalPersonaSearchAsync())">
                                                Buscar Persona
                                            </MudButton>

                                            @if (Ficha.InformanteId == 0)
                                            {
                                                <input @key="Ficha.InformanteId"
                                                       type="text"
                                                       value=""
                                                       required
                                                       oninvalid="this.setCustomValidity('Debe buscar y seleccionar un entrevistado.')"
                                                       oninput="this.setCustomValidity('')"
                                                       style="opacity: 0; width: 1px; height: 1px; position: absolute; pointer-events: none;" />
                                            }
                                            else
                                            {
                                                <input @key="Ficha.InformanteId"
                                                       type="text"
                                                       value="@Ficha.InformanteId"
                                                       style="opacity: 0; width: 1px; height: 1px; position: absolute; pointer-events: none;" />
                                            }
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="Primer Nombre"
                                                          Variant="Variant.Filled"
                                                          @bind-Value="informante!.PrimerNombre"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="Segundo Nombre"
                                                          Variant="Variant.Filled"
                                                          @bind-Value="informante!.SegundoNombre"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="Primer Apellido"
                                                          Variant="Variant.Filled"
                                                          @bind-Value="informante!.PrimerApellido"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="Segundo Apellido"
                                                          Variant="Variant.Filled"
                                                          @bind-Value="informante!.SegundoApellido"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="Identificación"
                                                          Variant="Variant.Filled"
                                                          @bind-Value="informante!.Identificacion"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="Genero"
                                                          Variant="Variant.Filled"
                                                          @bind-Value="informante!.Genero"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudNumericField Label="Edad"
                                                             Variant="Variant.Filled"
                                                             @bind-Value="informante!.Edad"
                                                             Margin="Margin.Dense"
                                                             ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="Estado Civil"
                                                          Variant="Variant.Filled"
                                                          Value="@(informante?.EstadoCivil?.Nombre ?? string.Empty)"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField Label="Profesión u Oficio"
                                                          Variant="Variant.Filled"
                                                          Value="@(informante?.Profesion?.Nombre ?? string.Empty)"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="Departamento"
                                                          Variant="Variant.Filled"
                                                          Value="@(informante?.Municipio?.Departamento?.Nombre ?? string.Empty)"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="Municipio"
                                                          Variant="Variant.Filled"
                                                          Value="@(informante?.Municipio?.Nombre ?? string.Empty)"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="Barrio/Comarca"
                                                          Variant="Variant.Filled"
                                                          Value="@(informante?.BarrioComarca?.Nombre ?? string.Empty)"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12" sm="3">
                                            <MudTextField Label="Caserío"
                                                          Variant="Variant.Filled"
                                                          Value="@(informante?.Caserio?.Nombre ?? string.Empty)"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudTextField Label="Dirección Domiciliar"
                                                          Variant="Variant.Filled"
                                                          @bind-Value="informante!.Direccion"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="Diccionario"
                                                             Label="Relación con Parcela"
                                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un tipo --")"
                                                             SearchFunc="SearchRelacionInformanteParcela"
                                                             Value="selectedRelacionInformanteParcela"
                                                             ValueChanged="RelacionInformanteParcelaChanged"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Disabled="loading"
                                                             ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                                <ItemTemplate Context="itemContext">
                                                    @itemContext.Nombre
                                                </ItemTemplate>
                                            </MudAutocomplete>
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MudAutocomplete T="Diccionario"
                                                             Label="Relación con Propietario"
                                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un tipo --")"
                                                             SearchFunc="SearchRelacionInformantePropietario"
                                                             Value="selectedRelacionInformantePropietario"
                                                             ValueChanged="RelacionInformantePropietarioChanged"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Disabled="loading"
                                                             ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                                <ItemTemplate Context="itemContext">
                                                    @itemContext.Nombre
                                                </ItemTemplate>
                                            </MudAutocomplete>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            </MudPaper>

                            <!-- Botones de acción dentro de la pestaña -->
                            <MudItem xs="12" class="d-flex justify-end gap-2 mt-4">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           ButtonType="ButtonType.Submit"
                                           Disabled="loading">
                                    Guardar
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudTabPanel>

                <!-- TAB 2: Propietarios -->
                <MudTabPanel Text="Propietarios"
                             Icon="@Icons.Material.Filled.People"
                             IconColor="Color.Default"
                             Class="pa-0">
                    @if (Ficha.Id > 0)
                    {
                        <FichaPropietariosDetails FichaId="Ficha.Id" />
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="ma-4">
                            <MudText>
                                <b>⚠️ Guarda la ficha primero</b>
                                <br />
                                Los propietarios solo pueden gestionarse después de guardar la ficha.
                            </MudText>
                        </MudAlert>
                    }
                </MudTabPanel>

                <!-- TAB 3: Núcleo Familiar -->
                <MudTabPanel Text="Núcleo Familiar"
                             Icon="@Icons.Material.Filled.FamilyRestroom"
                             IconColor="Color.Default">
                    @if (Ficha.Id > 0)
                    {
                        <FichaFamiliasDetails FichaId="Ficha.Id" />
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                            <MudText>
                                <b>⚠️ Guarda la ficha primero</b>
                                <br />
                                El núcleo familiar solo puede gestionarse después de guardar la ficha.
                            </MudText>
                        </MudAlert>
                    }
                </MudTabPanel>

                <!-- TAB 4: Colindantes -->
                <MudTabPanel Text="Colindantes"
                             Icon="@Icons.Material.Filled.BorderAll"
                             IconColor="Color.Default">
                    @if (Ficha.Id > 0)
                    {
                        <FichaColindantesDetails FichaId="Ficha.Id" />
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                            <MudText>
                                <b>⚠️ Guarda la ficha primero</b>
                                <br />
                                Los colindantes solo pueden gestionarse después de guardar la ficha.
                            </MudText>
                        </MudAlert>
                    }
                </MudTabPanel>

                <!-- TAB 5: Conflictos -->
                <MudTabPanel Text="Conflictos"
                             Icon="@Icons.Material.Filled.WarningAmber"
                             IconColor="Color.Default">
                    @if (Ficha.Id > 0)
                    {
                        <FichaConflictosDetails FichaId="Ficha.Id" />
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                            <MudText>
                                <b>⚠️ Guarda la ficha primero</b>
                                <br />
                                Los conflictos solo pueden gestionarse después de guardar la ficha.
                            </MudText>
                        </MudAlert>
                    }
                </MudTabPanel>

                <!-- TAB 6: Documentos Anexos -->
                <MudTabPanel Text="Documentos Anexos"
                             Icon="@Icons.Material.Filled.AttachFile"
                             IconColor="Color.Default">
                    @if (Ficha.Id > 0)
                    {
                        <FichaDocumentosAnexosDetails FichaId="Ficha.Id" />
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                            <MudText>
                                <b>⚠️ Guarda la ficha primero</b>
                                <br />
                                Los documentos anexos solo pueden gestionarse después de guardar la ficha.
                            </MudText>
                        </MudAlert>
                    }
                </MudTabPanel>
            </MudTabs>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    private int activeTabIndex = 0;
}