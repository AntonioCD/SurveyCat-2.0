@using SurveyCat.Shared.Enums;
@using SurveyCat.Shared.Entities
@using System.ComponentModel.DataAnnotations

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    @if (editContext?.GetValidationMessages().Any() == true)
    {
        <MudPaper Class="validation-summary-custom pa-3 mb-4" Elevation="1">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" />
                <MudText Typo="Typo.subtitle2" Color="Color.Error">
                    <b>Corrige los siguientes errores:</b>
                </MudText>
            </div>
            <ul class="pl-4 mb-0">
                @foreach (var message in editContext.GetValidationMessages())
                {
                    <li>@message</li>
                }
            </ul>
        </MudPaper>
    }

    <MudGrid Spacing="3">
        <!-- ================= ENCABEZADO PRINCIPAL ================= -->
        <MudItem xs="12">
            <div class="d-flex align-center justify-space-between gap-3 pb-2">
                <div class="d-flex align-center gap-3">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Secondary"
                                   OnClick="ReturnAction"
                                   Title="Regresar"
                                   Size="Size.Large" />
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Medium" />
                    </MudAvatar>
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold">
                            <b>@(Ficha?.Id != 0 ? "Editar Ficha" : "Nueva Ficha")</b>
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Complete los datos requeridos para registrar o editar una encuesta catastral.
                        </MudText>
                    </div>
                </div>

                <div style="width: 280px;">
                    @if (Ficha.Id != 0) 
                    {
                        <MudField Label="CÓDIGO DE ENCUESTA"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense">
                            <MudText Typo="Typo.body1" Color="Color.Primary">
                                <b>@Ficha.CodEncuesta</b>
                            </MudText>
                        </MudField>
                    } else {
                        <MudAutocomplete T="EncuestaAutorizada"
                                         Label="CÓDIGO DE ENCUESTA"
                                         Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un código --")"
                                         SearchFunc="SearchEncuestaAutorizada"
                                         Value="selectedEncuestaAutorizada"
                                         ValueChanged="EncuestaAutorizadaChanged"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Disabled="loading || Ficha.Id != 0"
                                         Required="true"
                                         RequiredError="Debe seleccionar un código de encuesta autorizada."
                                         For="@(() => selectedEncuestaAutorizada)"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="false"
                                         CoerceValue="false"
                                         ToStringFunc="@(e => e == null ? null : $"{e.CodEncuesta}")">
                            <ItemTemplate Context="itemContext">
                                <div class="d-flex flex-column">
                                    <MudText Typo="Typo.body1">
                                        <strong>@itemContext.CodEncuesta</strong>
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @itemContext.Municipio?.Nombre - @(itemContext.BarrioComarca?.Nombre ?? "SD")
                                    </MudText>
                                </div>
                            </ItemTemplate>
                            <NoItemsTemplate>
                                <MudText Typo="Typo.body2" Color="Color.Warning" Class="pa-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                                    No hay códigos disponibles
                                </MudText>
                            </NoItemsTemplate>
                        </MudAutocomplete>
                    }
                </div>
            </div>
            <MudDivider />
        </MudItem>

        <!-- ================= PESTAÑAS ================= -->
        <MudItem xs="12">
            <MudTabs Elevation="1"
                     Centered="true"
                     Color="Color.Primary"
                     @bind-ActivePanelIndex="activeTabIndex"
                     Class="rounded-lg">

                <!-- TAB 1: DATOS DE LA FICHA -->
                <MudTabPanel Text="Datos de la Ficha"
                             Icon="@Icons.Material.Filled.Description"
                             IconColor="Color.Default">
                    <div class="pa-4">
                        <MudGrid Spacing="3">

                            <!-- SECCIÓN 1: DATOS GENERALES -->
                            <MudItem xs="12">
                                <MudCard Elevation="1" Outlined="true" Class="rounded-lg">
                                    <MudCardHeader Class="pb-2">
                                        <CardHeaderContent>
                                            <div class="d-flex align-center gap-2">
                                                <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-semibold">Datos Generales</MudText>
                                            </div>
                                        </CardHeaderContent>
                                        <CardHeaderActions>
                                            @if (loading)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="mt-2 mr-2" />
                                            }
                                        </CardHeaderActions>
                                    </MudCardHeader>

                                    <MudCardContent>
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="4">
                                                <MudSelect T="TipoSector" Label="Tipo de Sector"
                                                           @bind-Value="Ficha.TipoSector"
                                                           For="@(() => Ficha.TipoSector)"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense">
                                                    @foreach (TipoSector item in Enum.GetValues(typeof(TipoSector)))
                                                    {
                                                        <MudSelectItem Value="@item">@item.ToString()</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>

                                            <MudItem xs="12" sm="4">
                                                <MudAutocomplete T="Departamento"
                                                                 Label="Departamento"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchDepartamento"
                                                                 Value="selectedDepartamento"
                                                                 ValueChanged="DepartamentoChangedAsync"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading"
                                                                 Required="true"
                                                                 RequiredError="El Departamento es requerido."
                                                                 For="@(() => selectedDepartamento)"
                                                                 ToStringFunc="@(e => e?.Nombre)" />
                                            </MudItem>

                                            <MudItem xs="12" sm="4">
                                                <MudAutocomplete T="Municipio"
                                                                 Label="Municipio"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchMunicipio"
                                                                 Value="selectedMunicipio"
                                                                 ValueChanged="MunicipioChangedAsync"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading"
                                                                 Required="true"
                                                                 RequiredError="El Municipio es requerido."
                                                                 For="@(() => selectedMunicipio)"
                                                                 ToStringFunc="@(e => e?.Nombre)" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>

                            <!-- SECCIÓN 2: PERSONAL DE ENCUESTA -->
                            <MudItem xs="12">
                                <MudCard Elevation="1" Outlined="true" Class="rounded-lg">
                                    <MudCardHeader Class="pb-2">
                                        <CardHeaderContent>
                                            <div class="d-flex align-center gap-2">
                                                <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-semibold">Personal de Encuesta</MudText>
                                            </div>
                                        </CardHeaderContent>
                                    </MudCardHeader>

                                    <MudCardContent>
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="4">
                                                <MudAutocomplete T="PersonalEncuesta"
                                                                 Label="Encuestador"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchEncuestador"
                                                                 Value="selectedEncuestador"
                                                                 ValueChanged="EncuestadorChanged"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading"
                                                                 Required="true"
                                                                 RequiredError="El Encuestador es requerido."
                                                                 For="@(() => selectedEncuestador)"
                                                                 ToStringFunc="@(e => e?.Persona?.NombreCompleto)" />
                                            </MudItem>

                                            <MudItem xs="12" sm="4">
                                                <MudAutocomplete T="PersonalEncuesta"
                                                                 Label="Técnico Catastral"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchTecnicoCatastral"
                                                                 Value="selectedTecnicoCatastral"
                                                                 ValueChanged="TecnicoCatastralChanged"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading"
                                                                 Required="true"
                                                                 RequiredError="El Técnico es requerido."
                                                                 For="@(() => selectedTecnicoCatastral)"
                                                                 ToStringFunc="@(e => e?.Persona?.NombreCompleto)" />
                                            </MudItem>

                                            <MudItem xs="12" sm="4">
                                                <MudAutocomplete T="PersonalEncuesta"
                                                                 Label="Jefe de Campo"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchSupervisor"
                                                                 Value="selectedSupervisor"
                                                                 ValueChanged="SupervisorChanged"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading"
                                                                 Required="true"
                                                                 RequiredError="El Jefe de Campo es requerido."
                                                                 For="@(() => selectedSupervisor)"
                                                                 ToStringFunc="@(e => e?.Persona?.NombreCompleto)" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>

                            <!-- SECCIÓN 3: DATOS DEL INMUEBLE -->
                            <MudItem xs="12">
                                <MudCard Elevation="1" Outlined="true" Class="rounded-lg">
                                    <MudCardHeader Class="pb-2">
                                        <CardHeaderContent>
                                            <div class="d-flex align-center gap-2">
                                                <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-semibold">Datos del Inmueble</MudText>
                                            </div>
                                        </CardHeaderContent>
                                    </MudCardHeader>

                                    <MudCardContent>
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="TipoEncuesta" Label="Tipo de Parcela"
                                                           @bind-Value="Ficha.TipoEncuesta"
                                                           For="@(() => Ficha.TipoEncuesta)"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           Disabled="loading">
                                                    @foreach (TipoEncuesta item in Enum.GetValues(typeof(TipoEncuesta)))
                                                    {
                                                        <MudSelectItem Value="@item">
                                                            @((int)item == 0 ? "-- Seleccione un Tipo --" : item.ToString())
                                                        </MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>

                                            <MudItem xs="12" sm="6">
                                                <MudTextField Label="Nombre de la Finca"
                                                              @bind-Value="Ficha.NombreFinca"
                                                              @bind-Value:after="() => Ficha.NombreFinca = Ficha.NombreFinca?.ToUpper()"
                                                              Immediate="true"
                                                              For="@(() => Ficha.NombreFinca)"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Disabled="loading" />
                                            </MudItem>

                                            <MudItem xs="12" sm="4">
                                                <MudSelect T="TipoUsoParcela?" Label="Tipo de Uso"
                                                           @bind-Value="Ficha.TipoUso"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           Clearable="true"
                                                           Disabled="loading"
                                                           Placeholder="Seleccione">
                                                    @foreach (TipoUsoParcela item in Enum.GetValues(typeof(TipoUsoParcela)))
                                                    {
                                                        <MudSelectItem Value="@((TipoUsoParcela?)item)">@item.ToString()</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>

                                            <MudItem xs="12" sm="8">
                                                <MudTextField Label="Descripción del Uso"
                                                              @bind-Value="Ficha.DescripcionTipoUso"
                                                              @bind-Value:after="() => Ficha.DescripcionTipoUso = Ficha.DescripcionTipoUso?.ToUpper()"
                                                              Immediate="true"
                                                              For="@(() => Ficha.DescripcionTipoUso)"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Disabled="loading" />
                                            </MudItem>

                                            <MudItem xs="12" sm="4">
                                                <MudNumericField Label="Área Estimada"
                                                                 @bind-Value="Ficha.AreaEstimada"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading"
                                                                 HideSpinButtons="true" />
                                            </MudItem>

                                            <MudItem xs="12" sm="4">
                                                <MudAutocomplete T="Diccionario"
                                                                 Label="Unidad de Medida"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchUnidadMedida"
                                                                 Value="selectedUnidadMedida"
                                                                 ValueChanged="UnidadMedidaChanged"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading"
                                                                 ToStringFunc="@(e => e?.Nombre)" />
                                            </MudItem>

                                            <MudItem xs="12" sm="4">
                                                <MudAutocomplete T="Diccionario"
                                                                 Label="Origen de la Tierra"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchOrigenTierra"
                                                                 Value="selectedOrigenTierra"
                                                                 ValueChanged="OrigenTierraChanged"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading"
                                                                 ToStringFunc="@(e => e?.Nombre)" />
                                            </MudItem>

                                            <!-- SUBSECCIÓN: UBICACIÓN -->
                                            <MudItem xs="12" Class="mt-2">
                                                <div class="d-flex align-center gap-2 mb-1">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="fw-semibold">Ubicación de la Parcela</MudText>
                                                </div>
                                                <MudDivider Class="mb-3" />
                                            </MudItem>

                                            <MudItem xs="12" sm="6">
                                                <MudAutocomplete T="BarrioComarca"
                                                                 Label="Barrio / Comarca"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchBarrioComarca"
                                                                 Value="selectedBarrioComarca"
                                                                 ValueChanged="BarrioComarcaChangedAsync"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading"
                                                                 ToStringFunc="@(e => e?.Nombre)" />
                                            </MudItem>

                                            <MudItem xs="12" sm="6">
                                                <MudAutocomplete T="Caserio"
                                                                 Label="Caserío"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchCaserio"
                                                                 Value="selectedCaserio"
                                                                 ValueChanged="CaserioChanged"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading"
                                                                 ToStringFunc="@(e => e?.Nombre)" />
                                            </MudItem>

                                            <MudItem xs="12" sm="6">
                                                <MudTextField Label="Manzana"
                                                              @bind-Value="Ficha.Manzana"
                                                              @bind-Value:after="() => Ficha.Manzana = Ficha.Manzana?.ToUpper()"
                                                              Immediate="true"
                                                              For="@(() => Ficha.Manzana)"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Disabled="loading" />
                                            </MudItem>

                                            <MudItem xs="12" sm="6">
                                                <MudTextField Label="Lote"
                                                              @bind-Value="Ficha.Lote"
                                                              @bind-Value:after="() => Ficha.Lote = Ficha.Lote?.ToUpper()"
                                                              Immediate="true"
                                                              For="@(() => Ficha.Lote)"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Disabled="loading" />
                                            </MudItem>

                                            <MudItem xs="12">
                                                <MudTextField Label="Dirección Exacta"
                                                              @bind-Value="Ficha.Direccion"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Disabled="loading" />
                                            </MudItem>

                                            <!-- SUBSECCIÓN: SERVIDUMBRE -->
                                            <MudItem xs="12" Class="mt-2">
                                                <div class="d-flex align-center gap-2 mb-1">
                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="fw-semibold">Servidumbre</MudText>
                                                </div>
                                                <MudDivider Class="mb-3" />
                                            </MudItem>

                                            <MudItem xs="12" sm="3" Class="d-flex align-center">
                                                <MudCheckBox Label="¿Posee Servidumbre?"
                                                             @bind-Value="Ficha.Servidumbre"
                                                             Color="Color.Primary"
                                                             Disabled="loading"
                                                             For="@(() => Ficha.Servidumbre)" />
                                            </MudItem>

                                            <MudItem xs="12" sm="3">
                                                <MudAutocomplete T="Diccionario"
                                                                 Label="Servidumbre de Agua"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchServidumbreAgua"
                                                                 Value="selectedServidumbreAgua"
                                                                 ValueChanged="ServidumbreAguaChanged"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading || !Ficha.Servidumbre"
                                                                 ToStringFunc="@(e => e?.Nombre)" />
                                            </MudItem>

                                            <MudItem xs="12" sm="3">
                                                <MudAutocomplete T="Diccionario"
                                                                 Label="Servidumbre de Pase"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchServidumbrePase"
                                                                 Value="selectedServidumbrePase"
                                                                 ValueChanged="ServidumbrePaseChanged"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading || !Ficha.Servidumbre"
                                                                 ToStringFunc="@(e => e?.Nombre)" />
                                            </MudItem>

                                            <MudItem xs="12" sm="3">
                                                <MudAutocomplete T="Diccionario"
                                                                 Label="Servidumbre (Otra)"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchServidumbreOtra"
                                                                 Value="selectedServidumbreOtra"
                                                                 ValueChanged="ServidumbreOtraChanged"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading || !Ficha.Servidumbre"
                                                                 ToStringFunc="@(e => e?.Nombre)" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>

                            <!-- SECCIÓN 4: DATOS DEL INFORMANTE / ENTREVISTADO -->
                            <MudItem xs="12">
                                <MudCard Elevation="1" Outlined="true" Class="rounded-lg">
                                    <MudCardHeader Class="pb-2">
                                        <CardHeaderContent>
                                            <div class="d-flex align-center gap-2">
                                                <div>
                                                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-semibold">Datos del Informante / Entrevistado</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Información personal del informante vinculada a la encuesta.</MudText>
                                                </div>
                                            </div>
                                        </CardHeaderContent>
                                        <CardHeaderActions>
                                            <MudButton Variant="Variant.Outlined"
                                                       StartIcon="@Icons.Material.Filled.PersonSearch"
                                                       Color="Color.Info"
                                                       OnClick="@(() => ShowModalPersonaSearchAsync())"
                                                       Size="Size.Medium"
                                                       Class="mt-1">
                                                @(Ficha.InformanteId == 0 ? "Buscar Persona" : "Cambiar Persona")
                                            </MudButton>
                                        </CardHeaderActions>
                                    </MudCardHeader>

                                    <MudCardContent>
                                        @if (Ficha.InformanteId == 0)
                                        {
                                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="my-1">
                                                Debe buscar y seleccionar una persona registrada para vincularla como informante.
                                            </MudAlert>
                                        }
                                        else if (informante != null)
                                        {
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudTextField Label="Primer Nombre" Value="@informante.PrimerNombre" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudTextField Label="Segundo Nombre" Value="@informante.SegundoNombre" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudTextField Label="Primer Apellido" Value="@informante.PrimerApellido" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudTextField Label="Segundo Apellido" Value="@informante.SegundoApellido" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                                                </MudItem>

                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudTextField Label="Identificación" Value="@informante.Identificacion" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudTextField Label="Género" Value="@informante.Genero" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudNumericField Label="Edad" Value="@informante.Edad" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudTextField Label="Estado Civil" Value="@(informante.EstadoCivil?.Nombre ?? "-")" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                                                </MudItem>

                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudTextField Label="Profesión u Oficio" Value="@(informante.Profesion?.Nombre ?? "-")" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudTextField Label="Departamento" Value="@(informante.Municipio?.Departamento?.Nombre ?? "-")" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudTextField Label="Municipio" Value="@(informante.Municipio?.Nombre ?? "-")" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6" md="3">
                                                    <MudTextField Label="Barrio / Comarca" Value="@(informante.BarrioComarca?.Nombre ?? informante.Caserio?.Nombre ?? "-")" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                                                </MudItem>

                                                <MudItem xs="12">
                                                    <MudTextField Label="Dirección Domiciliar" Value="@informante.Direccion" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" Multiline="true" Rows="1" ShrinkLabel="true" />
                                                </MudItem>
                                            </MudGrid>
                                        }
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>

                            <!-- SECCIÓN 5: RELACIÓN DEL INFORMANTE -->
                            <MudItem xs="12">
                                <MudCard Elevation="1" Outlined="true" Class="rounded-lg">
                                    <MudCardHeader Class="pb-2">
                                        <CardHeaderContent>
                                            <div class="d-flex align-center gap-2">
                                                <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-semibold">Relación del Informante</MudText>
                                            </div>
                                        </CardHeaderContent>
                                    </MudCardHeader>

                                    <MudCardContent>
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="6">
                                                <MudAutocomplete T="Diccionario"
                                                                 Label="Relación con la Parcela"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchRelacionInformanteParcela"
                                                                 Value="selectedRelacionInformanteParcela"
                                                                 ValueChanged="RelacionInformanteParcelaChanged"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading"
                                                                 ToStringFunc="@(e => e?.Nombre)" />
                                            </MudItem>

                                            <MudItem xs="12" sm="6">
                                                <MudAutocomplete T="Diccionario"
                                                                 Label="Relación con el Propietario"
                                                                 Placeholder="@(loading ? "-- Cargando... --" : "-- Seleccione --")"
                                                                 SearchFunc="SearchRelacionInformantePropietario"
                                                                 Value="selectedRelacionInformantePropietario"
                                                                 ValueChanged="RelacionInformantePropietarioChanged"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="loading"
                                                                 ToStringFunc="@(e => e?.Nombre)" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>

                            <!-- BOTONES DE ACCIÓN DEL TAB 1 -->
                            <MudItem xs="12" Class="d-flex justify-end gap-3 my-2">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Secondary"
                                           OnClick="ReturnAction"
                                           StartIcon="@Icons.Material.Filled.Cancel">
                                    Cancelar
                                </MudButton>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           ButtonType="ButtonType.Submit"
                                           Disabled="loading"
                                           StartIcon="@Icons.Material.Filled.Save">
                                    Guardar Datos
                                </MudButton>
                            </MudItem>

                        </MudGrid>
                    </div>
                </MudTabPanel>

                <!-- TAB 2: PROPIETARIOS -->
                <MudTabPanel Text="Propietarios" Icon="@Icons.Material.Filled.People" IconColor="Color.Default">
                    <div class="pa-4">
                        @if (Ficha.Id > 0)
                        {
                            <FichaPropietariosDetails FichaId="Ficha.Id" />
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                <b>Guarde la ficha primero:</b> Los propietarios solo pueden gestionarse después de guardar la ficha inicial.
                            </MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- TAB 3: OCUPANTES -->
                <MudTabPanel Text="Ocupantes" Icon="@Icons.Material.Filled.FamilyRestroom" IconColor="Color.Default">
                    <div class="pa-4">
                        @if (Ficha.Id > 0)
                        {
                            <FichaOcupantesDetails FichaId="Ficha.Id" />
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                <b>Guarde la ficha primero:</b> Los ocupantes solo pueden gestionarse después de guardar la ficha inicial.
                            </MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- TAB 4: COLINDANTES -->
                <MudTabPanel Text="Colindantes" Icon="@Icons.Material.Filled.BorderAll" IconColor="Color.Default">
                    <div class="pa-4">
                        @if (Ficha.Id > 0)
                        {
                            <FichaColindantesDetails FichaId="Ficha.Id" />
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                <b>Guarde la ficha primero:</b> Los colindantes solo pueden gestionarse después de guardar la ficha inicial.
                            </MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- TAB 5: CONFLICTOS -->
                <MudTabPanel Text="Conflictos" Icon="@Icons.Material.Filled.WarningAmber" IconColor="Color.Default">
                    <div class="pa-4">
                        @if (Ficha.Id > 0)
                        {
                            <FichaConflictosDetails FichaId="Ficha.Id" />
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                <b>Guarde la ficha primero:</b> Los conflictos solo pueden gestionarse después de guardar la ficha inicial.
                            </MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- TAB 6: DOCUMENTOS ANEXOS -->
                <MudTabPanel Text="Documentos Anexos" Icon="@Icons.Material.Filled.AttachFile" IconColor="Color.Default">
                    <div class="pa-4">
                        @if (Ficha.Id > 0)
                        {
                            <FichaDocumentosAnexosDetails FichaId="Ficha.Id" />
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                <b>Guarde la ficha primero:</b> Los documentos anexos solo pueden gestionarse después de guardar la ficha inicial.
                            </MudAlert>
                        }
                    </div>
                </MudTabPanel>

            </MudTabs>
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    private int activeTabIndex = 0;
}