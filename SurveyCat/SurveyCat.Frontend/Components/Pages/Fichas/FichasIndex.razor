@page "/fichas"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Fichas"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <div class="d-flex justify-content-between">
                <MudText Typo="Typo.h6" Class="me-4">FICHAS</MudText>
                <MudButton Variant="Variant.Outlined"
                           EndIcon="@Icons.Material.Filled.Add"
                           Color="Color.Info" OnClick="@(() => RedirectToFichaForm())">
                    Nuevo
                </MudButton>
            </div>
            <MudSpacer />
            <FilterComponent @bind-FilterValue="Filter" ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="width: 18%;">Municipio</MudTh>
            <MudTh Style="width: 18%;">Sector</MudTh>
            <MudTh Style="width: 18%;">CodEnc</MudTh>
            <MudTh Style="width: 18%;">Estado</MudTh>
            <MudTh Style="width: 9%;"># Propietarios</MudTh>
            <MudTh Style="width: 9%;"># Familiares</MudTh>
            <MudTh Style="width: 9%;"># Colindantes</MudTh>
            <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Municipio">@(context.Municipio?.Nombre ?? "SD")</MudTd>
            <MudTd DataLabel="Sector">@(context.Sector?.NumeroSector ?? "SD")</MudTd>
            <MudTd DataLabel="CodEnc">@context.CodEncuesta</MudTd>
            <MudTd DataLabel="Estado">@(context.Estado?.Nombre ?? "SD")</MudTd>
            <MudTd DataLabel="Propietarios">
                <MudTooltip Text="Ver Propietarios">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               Size="Size.Medium"
                               OnClick="@(() => PropietariosAction(@context))"
                               Style="width: 70px; min-width: 70px; color: #607D8B; border-color: #607D8B;"
                               Class="d-flex justify-space-between px-2">

                        <span>@context.PropietariosNumber</span>

                        <MudIcon Icon="@Icons.Material.TwoTone.ArrowCircleRight"
                                 Size="Size.Small"
                                 Class="ml-2" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Nucleo Familiar">
                <MudTooltip Text="Ver Nucleo Familiar">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               Size="Size.Medium"
                               OnClick="@(() => NucleoFamiliarAction(@context))"
                               Style="width: 70px; min-width: 70px; color: #607D8B; border-color: #607D8B;"
                               Class="d-flex justify-space-between px-2">

                        <span>@context.FamiliasNumber</span>

                        <MudIcon Icon="@Icons.Material.TwoTone.ArrowCircleRight"
                                 Size="Size.Small"
                                 Class="ml-2" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Colindantes">
                <MudTooltip Text="Ver Colindantes">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               Size="Size.Medium"
                               OnClick="@(() => ColindantesAction(@context))"
                               Style="width: 70px; min-width: 70px; color: #607D8B; border-color: #607D8B;"
                               Class="d-flex justify-space-between px-2">

                        <span>@context.ColindantesNumber</span>

                        <MudIcon Icon="@Icons.Material.TwoTone.ArrowCircleRight"
                                 Size="Size.Small"
                                 Class="ml-2" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: center; white-space: nowrap;">
                <div class="d-flex justify-center">
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       OnClick="@(() => RedirectToFichaForm(context.Id, true))"
                                       Size="Size.Medium"
                                       Class="mr-2" />
                    </MudTooltip>
                    <MudTooltip Text="Borrar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context))"
                                       Size="Size.Medium" />
                    </MudTooltip>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>"No hay registros"</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat" />
        </PagerContent>
    </MudTable>
}