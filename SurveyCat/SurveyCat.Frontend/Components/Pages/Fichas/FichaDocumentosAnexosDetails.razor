@page "/fichas/documentosAnexos/details/{FichaId:int}"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@documentosAnexos"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6" Class="mr-4">DOCUMENTOS ANEXOS (@ficha?.CodEncuesta)</MudText>
            <MudButton Variant="Variant.Outlined" Class="mr-4" EndIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="@(() => ShowModalAsync())">Crear</MudButton>
            <MudSpacer />
            <FilterComponent ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="width: 39%;">Documento</MudTh>
            <MudTh Style="width: 20%;">Código</MudTh>
            <MudTh Style="width: 20%;"># Páginas</MudTh>
            <MudTh Style="width: 20%;"># Adjuntos</MudTh>
            <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Documento">@context.Documento?.Nombre</MudTd>
            <MudTd DataLabel="Documento">@context.Documento?.Codigo</MudTd>
            <MudTd DataLabel="# Páginas">@context.NumeroPaginas</MudTd>
            <MudTd DataLabel="Adjuntos">
                <MudTooltip Text="Gestionar Adjuntos">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               Size="Size.Medium"
                               OnClick="@(() => ShowAdjuntosModalAsync(@context))"
                               Style="width: 70px; min-width: 70px; color: #607D8B; border-color: #607D8B;"
                               Class="d-flex justify-space-between px-2">

                        <span>@context.AdjuntosNumber</span>

                        <MudIcon Icon="@Icons.Material.TwoTone.ArrowCircleRight"
                                 Size="Size.Small"
                                 Class="ml-2" />
                    </MudButton>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: center; white-space: nowrap;">
                <div class="d-flex justify-center">
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       OnClick="@(() => ShowModalAsync(context.Id, true))"
                                       Size="Size.Medium"
                                       Class="mr-2" />
                    </MudTooltip>
                    <MudTooltip Text="Borrar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context))"
                                       Size="Size.Medium" />
                    </MudTooltip>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No se encontraron registros.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Numero de Registros:"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todos"
                           InfoFormat="@infoFormat" />
        </PagerContent>
    </MudTable>
}
