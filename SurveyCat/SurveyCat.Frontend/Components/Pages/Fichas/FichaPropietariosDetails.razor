@page "/fichas/propietarios/details/{FichaId:int}"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@propietarios"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6" Class="mr-4">PROPIETARIOS (@ficha?.CodEncuesta)</MudText>
            <!-- Quitamos el botón "Regresar" porque ya estamos dentro de la ficha -->
            <MudButton Variant="Variant.Outlined" Class="mr-4" EndIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="@(() => RedirectToPropietarioForm())">Crear</MudButton>
            <MudSpacer />
            <FilterComponent ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="width: 20%;">Nombre / Razon Social</MudTh>
            <MudTh Style="width: 20%;">Tipo de Derecho</MudTh>
            <MudTh Style="width: 20%;">Identificación</MudTh>
            <MudTh Style="width: 20%;">Tipo Identificación</MudTh>
            <MudTh Style="width: 20%;">¿Presenta Documento?</MudTh>
            <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre o Razón Social">@context.Persona?.NombreCompleto</MudTd>
            <MudTd DataLabel="Tipo de Derecho">@context.TipoDerecho</MudTd>
            <MudTd DataLabel="Identificación">@context.Persona?.Identificacion</MudTd>
            <MudTd DataLabel="Tipo Identificación">@context.Persona?.TipoIdentificacion?.Nombre</MudTd>
            <MudTd DataLabel="¿Presenta Documento?">
                @(context.PresentaDocumento ? "Sí" : "No")
            </MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: center; white-space: nowrap;">
                <div class="d-flex justify-center">
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       OnClick="@(() => RedirectToPropietarioForm(context.Id, true))"
                                       Size="Size.Medium"
                                       Class="mr-2" />
                    </MudTooltip>
                    <MudTooltip Text="Borrar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context))"
                                       Size="Size.Medium" />
                    </MudTooltip>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No se encontraron registros.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Numero de Registros:"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todos"
                           InfoFormat="@infoFormat" />
        </PagerContent>
    </MudTable>
}