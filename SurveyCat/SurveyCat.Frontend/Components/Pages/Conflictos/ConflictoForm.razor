@using SurveyCat.Shared.Enums;
@using SurveyCat.Shared.Entities
@using System.ComponentModel.DataAnnotations

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <MudGrid Spacing="3">
        <!-- ================= ENCABEZADO PRINCIPAL ================= -->
        <MudItem xs="12">
            <div class="d-flex align-center justify-space-between pb-2">
                <div class="d-flex align-center gap-3">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Medium" />
                    </MudAvatar>
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold">
                            <b>@(Conflicto?.Id != 0 ? "Editar Conflicto" : "Nuevo Conflicto")</b>
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Complete los datos requeridos para registrar o editar la información del conflicto.
                        </MudText>
                    </div>
                </div>
            </div>
            <MudDivider />
        </MudItem>

        <!-- ================= SECCIÓN PRINCIPAL EN MUDCARD ================= -->
        <MudItem xs="12">
            <MudCard Elevation="1" Outlined="true" Class="rounded-lg">
                <MudCardHeader Class="pb-2">
                    <CardHeaderContent>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-semibold">Detalles del Conflicto</MudText>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    <MudGrid Spacing="2">
                        <!-- FILA 1: Tipo de Conflicto y Gestión del Conflicto (Lado a lado) -->
                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="Diccionario"
                                             Label="Tipo de Conflicto"
                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un Conflicto --")"
                                             SearchFunc="SearchConflicto"
                                             Value="selectedConflicto"
                                             ValueChanged="ConflictoChanged"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             ResetValueOnEmptyText="true"
                                             Clearable="true"
                                             Disabled="loading"
                                             ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                <ItemTemplate Context="itemContext">
                                    @itemContext.Nombre
                                </ItemTemplate>
                            </MudAutocomplete>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="Diccionario"
                                             Label="Gestión del Conflicto"
                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione una Vía de Gestión --")"
                                             SearchFunc="SearchViaGestion"
                                             Value="selectedViaGestion"
                                             ValueChanged="ViaGestionChanged"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             ResetValueOnEmptyText="true"
                                             Clearable="true"
                                             Disabled="loading"
                                             ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                <ItemTemplate Context="itemContext">
                                    @itemContext.Nombre
                                </ItemTemplate>
                            </MudAutocomplete>
                        </MudItem>

                        <!-- FILA 2: Checkbox Estado -->
                        <MudItem xs="12" Class="d-flex align-center pt-2">
                            <MudCheckBox Label="¿Es con el Estado?"
                                         @bind-Value="Conflicto.ConEstado"
                                         Color="Color.Primary"
                                         For="@(() => Conflicto.ConEstado)" />
                        </MudItem>

                        <!-- FILA 3: Descripción detallada -->
                        <MudItem xs="12">
                            <MudTextField Label="Descripción del Conflicto"
                                          @bind-Value="Conflicto.Descripcion"
                                          For="@(() => Conflicto.Descripcion)"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="3"
                                          Placeholder="Describa brevemente la situación del conflicto..." />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- ================= BOTONES DE ACCIÓN ================= -->
        <MudItem xs="12" Class="d-flex justify-end gap-3 my-2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       OnClick="ReturnAction"
                       StartIcon="@Icons.Material.Filled.Cancel">
                Cancelar
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       ButtonType="ButtonType.Submit"
                       Disabled="loading"
                       StartIcon="@Icons.Material.Filled.Save">
                Guardar Conflicto
            </MudButton>
        </MudItem>
    </MudGrid>
</EditForm>




