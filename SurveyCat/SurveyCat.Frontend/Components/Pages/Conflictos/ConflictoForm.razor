@using SurveyCat.Shared.Enums;
@using SurveyCat.Shared.Entities
@using System.ComponentModel.DataAnnotations

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <ValidationSummary />

    <MudGrid>
        <MudItem xs="12" Class="mb-2">
            @* d-flex y justify-space-between empujan el título a la izquierda y el input a la derecha *@
            <div class="d-flex align-center justify-space-between gap-3 pl-1">

                @* BLOQUE IZQUIERDO: Icono + Título y Subtítulo *@
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAddAlt1" Color="Color.Primary" Size="Size.Large" />
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h5" Color="Color.Primary">
                            <b>@(Conflicto?.Id != 0 ? "Editar Conflicto" : "Nuevo Conflicto")</b>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Complete los datos requeridos para registrar/editar un conflicto.
                        </MudText>
                    </div>
                </div>
            </div>
            <MudDivider Class="mt-3 mb-2" DividerType="DividerType.FullWidth" />
        </MudItem>

        <MudItem xs="12">
            <MudAutocomplete T="Diccionario"
                             Label="Tipo de Conflicto"
                             Placeholder="-- Seleccione un Conflicto --"
                             SearchFunc="SearchConflicto"
                             Value="selectedConflicto"
                             ValueChanged="ConflictoChanged"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             ToStringFunc="@(e=> e==null?null : $"{e.Nombre}")">
                <ItemTemplate Context="itemContext">
                    @itemContext.Nombre
                </ItemTemplate>
            </MudAutocomplete>
        </MudItem>

        <MudItem xs="12">
            <MudAutocomplete T="Diccionario"
                             Label="Gestion del Conflicto"
                             Placeholder="-- Seleccione una Vía de Gestión --"
                             SearchFunc="SearchViaGestion"
                             Value="selectedViaGestion"
                             ValueChanged="ViaGestionChanged"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             ToStringFunc="@(e=> e==null?null : $"{e.Nombre}")">
                <ItemTemplate Context="itemContext">
                    @itemContext.Nombre
                </ItemTemplate>
            </MudAutocomplete>
        </MudItem>

        <MudItem xs="12" Class="d-flex justify-left">
            <MudCheckBox Label="¿Es con el Estado?"
                         @bind-Value="Conflicto.ConEstado"
                         Color="Color.Primary"
                         For="@(() => Conflicto.ConEstado)" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField Label="Descripción" @bind-Value="Conflicto.Descripcion" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>

        <MudItem xs="12" class="d-flex justify-end gap-2 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ReturnAction">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Guardar</MudButton>
        </MudItem>

    </MudGrid>
</EditForm>





