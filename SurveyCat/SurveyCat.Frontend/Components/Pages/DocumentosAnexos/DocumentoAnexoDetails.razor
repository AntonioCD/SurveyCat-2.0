@page "/documentoAnexo/details/{DocumentoAnexoId:int}"

<MudDialog>
    <DialogContent>
        @if (loading)
        {
            <Loading />
        }
        else
        {
            <div class="pa-2">
                <!-- Título -->
                <div class="d-flex align-center mb-4">
                    <MudText Typo="Typo.h6" Class="mr-4">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Class="mr-2" Color="Color.Primary" />
                        <b>ADJUNTOS - @documentoAnexo?.Documento?.Nombre</b>
                    </MudText>
                    <MudSpacer />
                    @if (documentoAnexo?.Ficha?.CodEncuesta != null)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   EndIcon="@Icons.Material.Filled.Add"
                                   Color="Color.Info"
                                   OnClick="@(() => ShowModalAsync())">
                            Crear Adjunto
                        </MudButton>
                    }
                    <FilterComponent ApplyFilter="SetFilterValue" Class="ml-2" />
                </div>

                <!-- Tabla de adjuntos -->
                <MudTable Items="@adjuntos"
                          @ref="table"
                          ServerData="LoadListAsync"
                          Dense="true"
                          Hover="true"
                          Striped="true"
                          FixedHeader="true"
                          FixedFooter="true">
                    <HeaderContent>
                        <MudTh Style="width: 10%;">Item</MudTh>
                        <MudTh Style="width: 30%;">Nombre de Archivo</MudTh>
                        <MudTh Style="width: 50%;">Ubicación</MudTh>
                        <MudTh Style="width: 10%; white-space: nowrap; text-align: center;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Item">@context.ItemPagina</MudTd>
                        <MudTd DataLabel="Nombre de Archivo">@context.NombreArchivo</MudTd>
                        <MudTd DataLabel="Ubicación">@context.Ruta</MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align: center; white-space: nowrap;">
                            <div class="d-flex justify-center">
                                <MudTooltip Text="Visualizar Documento">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Info"
                                                   OnClick="@(() => VerDocumentoCompletoAsync(context))"
                                                   Size="Size.Medium"
                                                   Class="mr-2" />
                                </MudTooltip>
                                <MudTooltip Text="Borrar">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteAsync(context))"
                                                   Size="Size.Medium" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText>No se encontraron adjuntos para este documento.</MudText>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager RowsPerPageString="Numero de Registros:"
                                       PageSizeOptions="pageSizeOptions"
                                       AllItemsText="Todos"
                                       InfoFormat="@infoFormat" />
                    </PagerContent>
                </MudTable>
            </div>
        }
    </DialogContent>
</MudDialog>