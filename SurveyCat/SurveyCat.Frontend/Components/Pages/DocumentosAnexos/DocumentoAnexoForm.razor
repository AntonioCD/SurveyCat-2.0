@using SurveyCat.Shared.Enums;
@using SurveyCat.Shared.Entities
@using System.ComponentModel.DataAnnotations

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        @* HEADER BAR *@
        <MudItem xs="12">
            <div class="d-flex align-center justify-space-between pa-2">
                <div class="d-flex align-center gap-3">
                    @* <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Color="Color.Secondary"
                                   OnClick="ReturnAction"
                                   Title="Regresar"
                                   Size="Size.Large" /> *@
                    <MudIcon Icon="@Icons.Material.Filled.AttachFile" Color="Color.Primary" Size="Size.Large" />
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h5" Color="Color.Primary">
                            <b>@(DocumentoAnexo?.Id != 0 ? "Editar Documento Anexo" : "Nuevo Documento Anexo")</b>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Complete los datos del documento y gestione sus archivos adjuntos.
                        </MudText>
                    </div>
                </div>
            </div>
            <MudDivider Class="mt-1 mb-3" />
        </MudItem>

        @* ================= SECCIÓN 1: DATOS DEL DOCUMENTO ANEXO ================= *@
        <MudItem xs="12">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Color="Color.Primary"><b>Datos del Documento Anexo</b></MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        @if (loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="mt-2 mr-2" />
                        }
                    </CardHeaderActions>
                </MudCardHeader>

                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="Diccionario"
                                             Label="Tipo de Documento"
                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un Documento --")"
                                             SearchFunc="SearchDocumento"
                                             Value="selectedDocumento"
                                             ValueChanged="DocumentoChanged"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             ResetValueOnEmptyText="true"
                                             Clearable="true"
                                             Disabled="@(loading || documentoGuardado)"
                                             Required="true"
                                             RequiredError="El tipo de documento es requerido."
                                             For="@(() => selectedDocumento)"
                                             ToStringFunc="@(e => e == null ? null : $"{e.Codigo} {e.Nombre}")">
                                <ItemTemplate Context="item">
                                    @item.Codigo - @item.Nombre
                                </ItemTemplate>
                            </MudAutocomplete>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudNumericField Label="# Páginas"
                                             @bind-Value="DocumentoAnexo.NumeroPaginas"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Disabled="@(loading || documentoGuardado)"
                                             Required="true"
                                             RequiredError="El número de páginas es requerido."
                                             For="@(() => DocumentoAnexo.NumeroPaginas)" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Descripción"
                                          @bind-Value="DocumentoAnexo.Descripcion"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="true"
                                          Disabled="@(loading || documentoGuardado)" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>

                @if (!documentoGuardado)
                {
                    <MudCardActions Class="d-flex justify-end gap-2 pa-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   OnClick="ReturnAction"
                                   StartIcon="@Icons.Material.Filled.Cancel">
                            Cancelar
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   ButtonType="ButtonType.Submit"
                                   Disabled="loading"
                                   StartIcon="@Icons.Material.Filled.Save">
                            Guardar Documento
                        </MudButton>
                    </MudCardActions>
                }
            </MudCard>
        </MudItem>

        @* ================= SECCIÓN 2: ADJUNTOS ================= *@
        @if (documentoGuardado)
        {
            <MudItem xs="12">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderAvatar>
                            <MudIcon Icon="@Icons.Material.Filled.Collections" Color="Color.Primary" />
                        </CardHeaderAvatar>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Color="Color.Primary"><b>Adjuntos del Documento</b></MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (!mostrandoFormularioAdjunto)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Color="Color.Info"
                                           Size="Size.Medium"
                                           Class="mt-2 mr-2"
                                           OnClick="@(() => AbrirFormularioAdjunto())">
                                    Agregar Adjunto
                                </MudButton>
                            }
                        </CardHeaderActions>
                    </MudCardHeader>

                    <MudCardContent>
                        @* TARJETA INTERNA: FORMULARIO DE NUEVO ADJUNTO *@
                        @if (mostrandoFormularioAdjunto)
                        {
                            <MudCard Outlined="true" Class="mb-4 border-left-4 border-info">
                                <MudCardHeader>
                                    <CardHeaderAvatar>
                                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Info" Size="Size.Small" />
                                    </CardHeaderAvatar>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.subtitle2" Color="Color.Info"><b>Nuevo Adjunto</b></MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>

                                <MudCardContent>
                                    <MudGrid>
                                        <MudItem xs="12">
                                            <MudFileUpload T="IBrowserFile" OnFilesChanged="OnFilesChangedHandler">
                                                <ActivatorContent>
                                                    <MudButton Variant="Variant.Outlined"
                                                               Color="@(string.IsNullOrEmpty(ArchivoOriginalName) ? Color.Primary : Color.Success)"
                                                               StartIcon="@Icons.Material.Filled.AttachFile"
                                                               Size="Size.Large"
                                                               FullWidth="true"
                                                               Style="height: 48px; border-style: dashed; border-width: 2px;">
                                                        @(string.IsNullOrEmpty(ArchivoOriginalName) ? "SELECCIONAR ARCHIVO" : $"{ArchivoOriginalName}")
                                                    </MudButton>
                                                </ActivatorContent>
                                            </MudFileUpload>
                                        </MudItem>

                                        <MudItem xs="12" sm="4">
                                            <MudNumericField Label="Número de Página"
                                                             @bind-Value="nuevoAdjunto.ItemPagina"
                                                             @bind-Value:after="GenerarNombreArchivoAdjunto"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Min="1"
                                                             Max="@(DocumentoAnexo.NumeroPaginas)" />
                                        </MudItem>

                                        <MudItem xs="12" sm="8">
                                            <MudTextField Label="Nombre Final (Automático)"
                                                          Value="@nuevoAdjunto.NombreArchivo"
                                                          Variant="Variant.Filled"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>

                                <MudCardActions Class="d-flex justify-end gap-2 pa-3">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               OnClick="@(() => CancelarAdjunto())">
                                        Cancelar
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               OnClick="@(async () => await GuardarAdjuntoAsync())"
                                               Disabled="@(!adjuntoListoParaGuardar)">
                                        Guardar Adjunto
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        }

                        @* GRID DE TARJETAS PARA LOS ARCHIVOS ADJUNTOS *@
                        @if (adjuntos != null && adjuntos.Any())
                        {
                            <MudGrid Spacing="2">
                                @foreach (var adjuntoRow in adjuntos)
                                {
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudPaper Outlined="true" Class="px-3 py-2 d-flex align-center justify-space-between gap-2" Style="border-radius: 6px;">
                                            <div class="d-flex align-center gap-2 overflow-hidden">
                                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text" Class="ma-0 pa-1">
                                                    <b>Pág. @adjuntoRow.ItemPagina</b>
                                                </MudChip>
                                                <MudText Typo="Typo.body2" Class="text-truncate" Title="@adjuntoRow.NombreArchivo">
                                                    @adjuntoRow.NombreArchivo
                                                </MudText>
                                            </div>

                                            <div class="d-flex align-center">
                                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                               Color="Color.Info"
                                                               Size="Size.Small"
                                                               OnClick="@(() => VerDocumentoAsync(adjuntoRow))" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="@(() => EliminarAdjuntoAsync(adjuntoRow))" />
                                            </div>
                                        </MudPaper>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
                                <MudText>No hay adjuntos registrados. Haga clic en <b>"Agregar Adjunto"</b> para comenzar.</MudText>
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end gap-2 mb-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.CheckCircle"
                           OnClick="@(() => Finalizar())">
                    Volver al listado
                </MudButton>
            </MudItem>
        }
    </MudGrid>
</EditForm>