@using SurveyCat.Shared.Enums;
@using SurveyCat.Shared.Entities
@using System.ComponentModel.DataAnnotations

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        @* BARRA DE ENCABEZADO *@
        <MudItem xs="12">
            <div class="d-flex align-center justify-space-between pa-2">
                <div class="d-flex align-center gap-3">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" />
                    </MudAvatar>
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h5" Color="Color.Primary">
                            <b>@(DocumentoAnexo?.Id != 0 ? "Editar Documento Anexo" : "Nuevo Documento Anexo")</b>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Complete los datos del documento y gestione sus archivos adjuntos.
                        </MudText>
                    </div>
                </div>
                @if (documentoGuardado)
                {
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                        Documento Guardado
                    </MudChip>
                }
            </div>
            <MudDivider Class="mt-1 mb-3" />
        </MudItem>

        @* ================= SECCIÓN 1: DATOS DEL DOCUMENTO ANEXO ================= *@
        <MudItem xs="12">
            <MudCard Elevation="2" Class="mb-4 rounded-lg">
                <MudCardHeader Class="pb-2">
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Color="Color.Primary"><b>Datos del Documento Anexo</b></MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Paso 1: Información básica del documento</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        @if (loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="mt-2 mr-2" />
                        }
                    </CardHeaderActions>
                </MudCardHeader>

                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="Diccionario"
                                             Label="Tipo de Documento"
                                             Placeholder="@(loading ? "-- Cargando datos... --" : "-- Seleccione un Documento --")"
                                             SearchFunc="SearchDocumento"
                                             Value="selectedDocumento"
                                             ValueChanged="DocumentoChanged"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             ResetValueOnEmptyText="true"
                                             Clearable="true"
                                             Disabled="@(loading || documentoGuardado)"
                                             Required="true"
                                             RequiredError="El tipo de documento es requerido."
                                             For="@(() => selectedDocumento)"
                                             ToStringFunc="@(e => e == null ? null : $"{e.Codigo} {e.Nombre}")">
                                <ItemTemplate Context="item">
                                    @item.Codigo - @item.Nombre
                                </ItemTemplate>
                            </MudAutocomplete>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudNumericField Label="# Páginas"
                                             @bind-Value="DocumentoAnexo.NumeroPaginas"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Disabled="@(loading || documentoGuardado)"
                                             Required="true"
                                             RequiredError="El número de páginas es requerido."
                                             For="@(() => DocumentoAnexo.NumeroPaginas)" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Descripción"
                                          @bind-Value="DocumentoAnexo.Descripcion"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="true"
                                          Disabled="@(loading || documentoGuardado)" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>

                @if (!documentoGuardado)
                {
                    <MudCardActions Class="d-flex justify-end gap-2 pa-4">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   OnClick="ReturnAction"
                                   StartIcon="@Icons.Material.Filled.Cancel">
                            Cancelar
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   ButtonType="ButtonType.Submit"
                                   Disabled="loading"
                                   StartIcon="@Icons.Material.Filled.Save">
                            Guardar Documento
                        </MudButton>
                    </MudCardActions>
                }
            </MudCard>
        </MudItem>

        @* ================= SECCIÓN 2: ADJUNTOS ================= *@
        @if (documentoGuardado)
        {
            <MudItem xs="12">
                <MudCard Elevation="2" Class="mb-4 rounded-lg">
                    <MudCardHeader Class="pb-2">
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Color="Color.Primary"><b>Adjuntos del Documento</b></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Paso 2: Carga y administración de imágenes asociadas</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            @if (!mostrandoFormularioAdjunto)
                            {
                                <MudButton Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Color="Color.Primary"
                                           Size="Size.Medium"
                                           Class="mt-2 mr-2"
                                           OnClick="@(() => AbrirFormularioAdjunto())">
                                    Agregar Adjunto
                                </MudButton>
                            }
                        </CardHeaderActions>
                    </MudCardHeader>

                    <MudCardContent>
                        @if (mostrandoFormularioAdjunto)
                        {
                            <MudCard Outlined="true" Class="mb-4 rounded-lg border-2" Style="border-color: var(--mud-palette-info);">
                                <MudCardHeader Class="pb-2">
                                    <CardHeaderAvatar>
                                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Info" Size="Size.Medium" />
                                    </CardHeaderAvatar>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.subtitle1" Color="Color.Info"><b>Cargar Nuevo Archivo Adjunto</b></MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>

                                <MudCardContent>
                                    <MudGrid>
                                        <MudItem xs="12">
                                            <InputFile id="fileFolderInput"
                                                       OnChange="UploadFolderAsync"
                                                       @attributes='new Dictionary<string, object> { { "webkitdirectory", "" } }'
                                                       style="display: none;" />

                                            @if (string.IsNullOrEmpty(CarpetaSeleccionada))
                                            {
                                                <MudButton Variant="Variant.Outlined"
                                                           Color="Color.Primary"
                                                           StartIcon="@Icons.Material.Filled.FolderOpen"
                                                           Size="Size.Large"
                                                           FullWidth="true"
                                                           Style="height: 52px; border-style: dashed; border-width: 2px;"
                                                           OnClick="AbrirSeleccionCarpeta">
                                                    SELECCIONAR CARPETA DE ENCUESTA
                                                </MudButton>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-center justify-space-between mb-3 pa-3 rounded-lg border-dashed border-1 mud-border-success" Style="background-color: var(--mud-palette-background-grey);">
                                                    <div class="d-flex align-center gap-2">
                                                        <MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Success" />
                                                        <MudText Typo="Typo.body2">
                                                            <b>Carpeta validada:</b> @CarpetaSeleccionada (@archivosEnCarpeta.Count archivos encontrados)
                                                        </MudText>
                                                    </div>
                                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="LimpiarSeleccionCarpeta">
                                                        Cambiar Carpeta
                                                    </MudButton>
                                                </div>

                                                <MudSelect T="IBrowserFile"
                                                           Label="Seleccionar Archivo de la Carpeta"
                                                           Value="selectedFile"
                                                           ValueChanged="OnFileSelectedFromFolder"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           ToStringFunc="@(f => f?.Name)">
                                                    @foreach (var file in archivosEnCarpeta)
                                                    {
                                                        <MudSelectItem Value="@file">@file.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            }
                                        </MudItem>

                                        <MudItem xs="12" sm="4">
                                            <MudNumericField Label="Número de Página"
                                                             @bind-Value="nuevoAdjunto.ItemPagina"
                                                             @bind-Value:after="GenerarNombreArchivoAdjunto"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Min="1"
                                                             Max="@(DocumentoAnexo.NumeroPaginas)" />
                                        </MudItem>

                                        <MudItem xs="12" sm="8">
                                            <MudTextField Label="Nombre Final (Automático)"
                                                          Value="@nuevoAdjunto.NombreArchivo"
                                                          Variant="Variant.Filled"
                                                          Margin="Margin.Dense"
                                                          ReadOnly="true" />
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>

                                <MudCardActions Class="d-flex justify-end gap-2 pa-3">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Secondary"
                                               OnClick="@(() => CancelarAdjunto())">
                                        Cancelar
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               OnClick="@(async () => await GuardarAdjuntoAsync())"
                                               Disabled="@(!adjuntoListoParaGuardar)">
                                        Guardar Adjunto
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        }

                        @if (adjuntos != null && adjuntos.Any())
                        {
                            <MudGrid Spacing="3">
                                @foreach (var adjuntoRow in adjuntos)
                                {
                                    <MudItem xs="6" sm="4" md="3" lg="2">
                                        <MudCard Elevation="1" Class="rounded-lg h-100 d-flex flex-column justify-space-between">
                                            <MudCardContent Class="pa-2">
                                                <div class="d-flex align-center gap-2 mb-2">
                                                    <MudAvatar Color="Color.Info" Variant="Variant.Text" Size="Size.Small">
                                                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" />
                                                    </MudAvatar>
                                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0 px-2">
                                                        Pág. @adjuntoRow.ItemPagina
                                                    </MudChip>
                                                </div>
                                                <MudText Typo="Typo.caption" Class="text-truncate d-block" Title="@adjuntoRow.NombreArchivo">
                                                    <b>@adjuntoRow.NombreArchivo</b>
                                                </MudText>
                                            </MudCardContent>

                                            <MudCardActions Class="d-flex justify-end border-top pa-1 gap-1">
                                                <MudTooltip Text="Visualizar adjunto">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                                   Color="Color.Info"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => VerDocumentoAsync(adjuntoRow))" />
                                                </MudTooltip>

                                                <MudTooltip Text="Eliminar adjunto">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                   Color="Color.Error"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => EliminarAdjuntoAsync(adjuntoRow))" />
                                                </MudTooltip>
                                            </MudCardActions>
                                        </MudCard>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2 rounded-lg" Icon="@Icons.Material.Filled.Info">
                                No hay adjuntos registrados. Haga clic en <b>"Agregar Adjunto"</b> para comenzar a subir imágenes.
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end gap-2 mb-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => Finalizar())">
                    Volver al listado
                </MudButton>
            </MudItem>
        }
    </MudGrid>
</EditForm>