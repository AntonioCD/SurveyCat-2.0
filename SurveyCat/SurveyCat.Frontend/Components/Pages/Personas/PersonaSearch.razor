<MudDialog>
    <DialogContent>
        <MudTable Items="@Personas"
                  @ref="tablePersonas"
                  ServerData="LoadListPersonasAsync"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  FixedHeader="true"
                  FixedFooter="true">
            <ToolBarContent>
                <div class="d-flex justify-content-between">
                    <MudText Typo="Typo.h6" Class="me-4">DEPARTAMENTOS</MudText>
                    <MudButton Variant="Variant.Outlined"
                               EndIcon="@Icons.Material.Filled.Add"
                               Color="Color.Info">
    
                        Nuevo
                    </MudButton>
                </div>
                <MudSpacer />
                <FilterComponent @bind-FilterValue="Filter" ApplyFilter="SetFilterValuePersonas" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Identificación</MudTh>
                <MudTh Style="width: 20%;">Nombre Completo | RUC</MudTh>
                <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">Acciones</MudTh>
            </HeaderContent>

            <RowTemplate Context="persona">
                <MudTd DataLabel="Identificación">@persona.Identificacion</MudTd>
                <MudTd DataLabel="Nombre Completo">@persona.NombreCompleto</MudTd>
                <MudTd DataLabel="Acciones" Style="text-align: center; white-space: nowrap;">
                    <div class="d-flex justify-center">
                        <MudTooltip Text="Seleccionar">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Variant="Variant.Outlined"
                                           Color="Color.Warning"
                                           Size="Size.Medium"
                                           Class="mr-2" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText>"No hay registros"</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="Número de registros"
                               PageSizeOptions="pageSizeOptions"
                               AllItemsText="Todo"
                               InfoFormat="@infoFormat" />
            </PagerContent>
        </MudTable>
    </DialogContent>
</MudDialog>