@using SurveyCat.Shared.Entities
@using System.ComponentModel.DataAnnotations

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <MudGrid Class="pa-2">
        @* HEADER DEL COMPONENTE *@
        <MudItem xs="12" Class="mb-2">
            <div class="d-flex align-center justify-space-between gap-3 pl-1">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary" Size="Size.Large" />
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h5" Color="Color.Primary">
                            <b>@(Adjunto?.Id != 0 ? "Editar Adjunto" : "Cargar Documento Adjunto")</b>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Suba el archivo digital y asigne el número de página correspondiente en el expediente.
                        </MudText>
                    </div>
                </div>
            </div>
            <MudDivider Class="mt-3 mb-2" DividerType="DividerType.FullWidth" />
        </MudItem>

        @* SECCIÓN DE SUBIDA DE ARCHIVO *@
        <MudItem xs="12">
            <MudFileUpload T="IBrowserFile" OnFilesChanged="UploadFileAsync">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined"
                               Color="@(string.IsNullOrEmpty(ArchivoOriginalName) ? Color.Primary : Color.Success)"
                               StartIcon="@Icons.Material.Filled.AttachFile"
                               Size="Size.Large"
                               FullWidth="true"
                               Style="height: 40px; border-style: dashed; border-width: 2px;">
                        @(string.IsNullOrEmpty(ArchivoOriginalName) ? "SELECCIONAR ARCHIVO" : $"{ArchivoOriginalName}")
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            <div class="mud-input-helper-text mud-input-error-text px-2 pt-1">
                <ValidationMessage For="@(() => Adjunto.NombreArchivo)" />
            </div>
        </MudItem>

        @* INPUT NUMÉRICO PARA ITEM PÁGINA (Con límite dinámico máximo) *@
        <MudItem xs="12" sm="4">
            <MudNumericField Label="Número de Página"
                             Value="Adjunto.ItemPagina"
                             ValueChanged="@((int value) => OnItemPaginaChanged(value))"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="1"
                             Max="@(documentoAnexo?.NumeroPaginas ?? int.MaxValue)"
                             For="@(() => Adjunto.ItemPagina)" />
        </MudItem>

        @* CAMPO DE SOLO LECTURA: Muestra el nombre final calculado de forma transparente *@
        <MudItem xs="12" sm="8">
            <MudTextField Label="Nombre Final del Archivo (Generado Automáticamente)"
                          Value="@Adjunto.NombreArchivo"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          ReadOnly="true"
                          Disabled="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Label" />
        </MudItem>

        @* BOTONERA PRINCIPAL UNIFICADA *@
        <MudItem xs="12" Class="d-flex justify-end gap-2 mt-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       OnClick="ReturnAction"
                       Class="px-6">
                CANCELAR
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       ButtonType="ButtonType.Submit"
                       Class="px-6">
                GUARDAR
            </MudButton>
        </MudItem>
    </MudGrid>
</EditForm>