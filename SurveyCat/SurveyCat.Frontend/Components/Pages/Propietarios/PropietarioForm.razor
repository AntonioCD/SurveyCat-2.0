@using SurveyCat.Shared.Enums;
@using SurveyCat.Shared.Entities
@using System.ComponentModel.DataAnnotations

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <ValidationSummary />

    <MudGrid>
        <MudItem xs="12" Class="mb-2">
            <div class="d-flex align-center justify-space-between gap-3 pl-1">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAddAlt1" Color="Color.Primary" Size="Size.Large" />
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h5" Color="Color.Primary">
                            <b>@(Propietario?.Id != 0 ? "Editar Propietario" : "Nuevo Propietario")</b>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Complete los datos requeridos para registrar/editar un propietario.
                        </MudText>
                    </div>
                </div>
            </div>
            <MudDivider Class="mt-3 mb-0" DividerType="DividerType.FullWidth" />
        </MudItem>

        <MudItem xs="12">
            <!-- ================= SECCIÓN: DATOS DE LA PERSONA ================= -->
            <MudPaper Class="mb-4" Elevation="0" Outlined="true" Style="border-radius: 8px; overflow: hidden;">
                <div class="section-header">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Size="Size.Small" />
                    <MudText>Datos de Propietario/Poseedor</MudText>
                </div>
                <div class="pa-4">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Outlined"
                                       EndIcon="@Icons.Material.Filled.PersonSearch"
                                       Color="Color.Info" OnClick="@(() => ShowModalPersonaSearchAsync())">
                                Buscar Persona
                            </MudButton>

                            @if (Propietario.PersonaId == 0)
                            {
                                <input @key="Propietario.PersonaId"
                                       type="text"
                                       value=""
                                       required
                                       oninvalid="this.setCustomValidity('Debe buscar y seleccionar una persona.')"
                                       oninput="this.setCustomValidity('')"
                                       style="opacity: 0; width: 1px; height: 1px; position: absolute; pointer-events: none;" />
                            }
                            else
                            {
                                <input @key="Propietario.PersonaId"
                                       type="text"
                                       value="@Propietario.PersonaId"
                                       style="opacity: 0; width: 1px; height: 1px; position: absolute; pointer-events: none;" />
                            }
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Primer Nombre"
                                          Variant="Variant.Filled"
                                          @bind-Value="persona!.PrimerNombre"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Segundo Nombre"
                                          Variant="Variant.Filled"
                                          @bind-Value="persona!.SegundoNombre"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Primer Apellido"
                                          Variant="Variant.Filled"
                                          @bind-Value="persona!.PrimerApellido"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Segundo Apellido"
                                          Variant="Variant.Filled"
                                          @bind-Value="persona!.SegundoApellido"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Identificación"
                                          Variant="Variant.Filled"
                                          @bind-Value="persona!.Identificacion"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Genero"
                                          Variant="Variant.Filled"
                                          @bind-Value="persona!.Genero"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudNumericField Label="Edad"
                                             Variant="Variant.Filled"
                                             @bind-Value="persona!.Edad"
                                             Margin="Margin.Dense"
                                             ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Estado Civil"
                                          Variant="Variant.Filled"
                                          Value="@(persona?.EstadoCivil?.Nombre ?? string.Empty)"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Profesión u Oficio"
                                          Variant="Variant.Filled"
                                          Value="@(persona?.Profesion?.Nombre ?? string.Empty)"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Departamento"
                                          Variant="Variant.Filled"
                                          Value="@(persona?.Municipio?.Departamento?.Nombre ?? string.Empty)"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Municipio"
                                          Variant="Variant.Filled"
                                          Value="@(persona?.Municipio?.Nombre ?? string.Empty)"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Barrio/Comarca"
                                          Variant="Variant.Filled"
                                          Value="@(persona?.BarrioComarca?.Nombre ?? string.Empty)"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudTextField Label="Caserío"
                                          Variant="Variant.Filled"
                                          Value="@(persona?.Caserio?.Nombre ?? string.Empty)"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Dirección Domiciliar"
                                          Variant="Variant.Filled"
                                          @bind-Value="persona!.Direccion"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </MudItem>
                    </MudGrid>
                </div>
            </MudPaper>

            <!-- ================= SECCIÓN: DERECHOS SOBRE LA PARCELA ================= -->
            <MudPaper Class="mb-4" Elevation="0" Outlined="true" Style="border-radius: 8px; overflow: hidden;">
                <div class="section-header">
                    <MudIcon Icon="@Icons.Material.Filled.Feed" Color="Color.Primary" Size="Size.Small" />
                    <MudText>Derechos sobre la Parcela</MudText>
                </div>
                <div class="pa-4">
                    <MudGrid>
                        <MudItem xs="12" sm="6" style="position: relative;">
                            <MudSelect T="TipoDerecho" Label="Tipo de Derecho"
                                       @bind-Value="Propietario.TipoDerecho"
                                       For="@(() => Propietario.TipoDerecho)"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Required="true"
                                       Validation="@(new RangeAttribute(1, int.MaxValue) { ErrorMessage = "Seleccione un Tipo de Derecho." })">

                                @foreach (TipoDerecho item in Enum.GetValues(typeof(TipoDerecho)))
                                {
                                    <MudSelectItem Value="@item">
                                        @((int)item == 0 ? "-- Seleccione un Tipo --" : item.ToString())
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            @if ((int)Propietario.TipoDerecho == 0)
                            {
                                <input @key="@((int)Propietario.TipoDerecho)"
                                       type="text"
                                       value=""
                                       required
                                       oninvalid="this.setCustomValidity('Seleccione un Tipo de Derecho.')"
                                       oninput="this.setCustomValidity('')"
                                       style="opacity: 0; width: 100%; height: 1px; position: absolute; bottom: 0; left: 0; pointer-events: none;" />
                            }
                            else
                            {
                                <input @key="@((int)Propietario.TipoDerecho)"
                                       type="text"
                                       value="@((int)Propietario.TipoDerecho)"
                                       style="opacity: 0; width: 100%; height: 1px; position: absolute; bottom: 0; left: 0; pointer-events: none;" />
                            }
                        </MudItem>

                        <MudItem xs="12" sm="6" Class="d-flex justify-left">
                            <MudCheckBox Label="¿Presenta Documento?"
                                         @bind-Value="Propietario.PresentaDocumento"
                                         Color="Color.Primary"
                                         For="@(() => Propietario.PresentaDocumento)" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudAutocomplete T="Diccionario"
                                             Label="Documento"
                                             Placeholder="-- Seleccione un Documento --"
                                             SearchFunc="SearchDocumento"
                                             Value="selectedDocumento"
                                             ValueChanged="DocumentoChanged"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                <ItemTemplate Context="itemContext">
                                    @itemContext.Nombre
                                </ItemTemplate>
                            </MudAutocomplete>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Autor del Documento"
                                          @bind-Value="Propietario.AutorDocumento"
                                          @bind-Value:after="() => Propietario.AutorDocumento = Propietario.AutorDocumento?.ToUpper()"
                                          Immediate="true"
                                          For="@(() => Propietario.AutorDocumento)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Fecha del Documento"
                                           @bind-Date="Propietario.FechaDocumento"
                                           For="@(() => Propietario.FechaDocumento)"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Editable="true"
                                           ImmediateText="true" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudNumericField Label="Area Titulada" @bind-Value="Propietario.AreaTitulada"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="Diccionario"
                                             Label="Unidad de Medida"
                                             Placeholder="-- Seleccione una UDM --"
                                             SearchFunc="SearchUnidadMedida"
                                             Value="selectedUnidadMedida"
                                             ValueChanged="UnidadMedidaChanged"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"
                                             ToStringFunc="@(e => e == null ? null : $"{e.Nombre}")">
                                <ItemTemplate Context="itemContext">
                                    @itemContext.Nombre
                                </ItemTemplate>
                            </MudAutocomplete>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Fecha de Adquisicion"
                                           @bind-Date="Propietario.FechaAdquisicion"
                                           For="@(() => Propietario.FechaAdquisicion)"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Editable="true"
                                           ImmediateText="true" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Fecha de Registro"
                                           @bind-Date="Propietario.FechaRegistro"
                                           For="@(() => Propietario.FechaRegistro)"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Editable="true"
                                           ImmediateText="true" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Finca"
                                          @bind-Value="Propietario.Finca"
                                          @bind-Value:after="() => Propietario.Finca = Propietario.Finca?.ToUpper()"
                                          Immediate="true"
                                          For="@(() => Propietario.Finca)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Tomo"
                                          @bind-Value="Propietario.Tomo"
                                          @bind-Value:after="() => Propietario.Tomo = Propietario.Tomo?.ToUpper()"
                                          Immediate="true"
                                          For="@(() => Propietario.Tomo)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Folio"
                                          @bind-Value="Propietario.Folio"
                                          @bind-Value:after="() => Propietario.Folio = Propietario.Folio?.ToUpper()"
                                          Immediate="true"
                                          For="@(() => Propietario.Folio)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Asiento"
                                          @bind-Value="Propietario.Asiento"
                                          @bind-Value:after="() => Propietario.Asiento = Propietario.Asiento?.ToUpper()"
                                          Immediate="true"
                                          For="@(() => Propietario.Asiento)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" class="d-flex justify-end gap-2 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ReturnAction">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Guardar</MudButton>
        </MudItem>

    </MudGrid>
</EditForm>