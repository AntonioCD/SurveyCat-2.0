@using SurveyCat.Shared.Enums;
@using SurveyCat.Shared.Entities
@using System.ComponentModel.DataAnnotations

<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

    <ValidationSummary />

    <MudGrid>
        <MudItem xs="12" Class="mb-2">
            <div class="d-flex align-center justify-space-between gap-3 pl-1">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAddAlt1" Color="Color.Primary" Size="Size.Large" />
                    <div class="d-flex flex-column">
                        <MudText Typo="Typo.h5" Color="Color.Primary">
                            <b>@(Propietario?.Id != 0 ? "Editar Propietario" : "Nuevo Propietario")</b>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Complete los datos requeridos para registrar/editar un propietario.
                        </MudText>
                    </div>
                </div>
            </div>
            <MudDivider Class="mt-3 mb-0" DividerType="DividerType.FullWidth" />
        </MudItem>

       
        <MudItem xs="12">
            <MudCard Elevation="1" Class="rounded-lg border-solid border-2 mud-border-lines-default">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Color="Color.Primary">Datos del Propietario</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Información vinculada a la persona seleccionada.</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Filled"
                                    StartIcon="@Icons.Material.Filled.PersonSearch"
                                    Color="Color.Info"
                                    OnClick="@(() => ShowModalPersonaSearchAsync())"
                                    Class="mt-2 mr-2">
                            Buscar Persona
                        </MudButton>
                    </CardHeaderActions>
                </MudCardHeader>

                <MudCardContent>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Primer Nombre" Value="@persona?.PrimerNombre" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Segundo Nombre" Value="@persona?.SegundoNombre" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Primer Apellido" Value="@persona?.PrimerApellido" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Segundo Apellido" Value="@persona?.SegundoApellido" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Identificación" Value="@persona?.Identificacion" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Género" Value="@persona?.Genero" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField Label="Edad" Value="@persona?.Edad" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Estado Civil" Value="@(persona?.EstadoCivil?.Nombre ?? "-")" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Profesión u Oficio" Value="@(persona?.Profesion?.Nombre ?? "-")" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Departamento" Value="@(persona?.Municipio?.Departamento?.Nombre ?? "-")" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Municipio" Value="@(persona?.Municipio?.Nombre ?? "-")" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Barrio / Comarca" Value="@(persona?.BarrioComarca?.Nombre ?? persona?.Caserio?.Nombre ?? "-")" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" ShrinkLabel="true" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Dirección Domiciliar" Value="@persona?.Direccion" Variant="Variant.Filled" Margin="Margin.Dense" ReadOnly="true" Multiline="true" Rows="1" ShrinkLabel="true" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- ================= SECCIÓN 2: DERECHOS Y DOCUMENTACIÓN ================= -->
        <MudItem xs="12">
            <MudCard Elevation="1" Outlined="true" Class="rounded-lg">
                <MudCardHeader Class="pb-2">
                    <CardHeaderContent>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-semibold">Derechos sobre la Parcela</MudText>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudSelect T="TipoDerecho"
                                       Label="Tipo de Derecho"
                                       @bind-Value="Propietario.TipoDerecho"
                                       For="@(() => Propietario.TipoDerecho)"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter">
                                @foreach (TipoDerecho item in Enum.GetValues(typeof(TipoDerecho)))
                                {
                                    <MudSelectItem Value="@item">
                                        @((int)item == 0 ? "-- Seleccione un Tipo --" : item.ToString())
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6" Class="d-flex align-center">
                            <MudCheckBox Label="¿Presenta Documento Soporte?"
                                         @bind-Value="Propietario.PresentaDocumento"
                                         Color="Color.Primary"
                                         For="@(() => Propietario.PresentaDocumento)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="Diccionario"
                                             Label="Tipo de Documento"
                                             Placeholder="Seleccione un documento..."
                                             SearchFunc="SearchDocumento"
                                             Value="selectedDocumento"
                                             ValueChanged="DocumentoChanged"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             ToStringFunc="@(e => e?.Nombre)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Autor del Documento"
                                          @bind-Value="Propietario.AutorDocumento"
                                          @bind-Value:after="() => Propietario.AutorDocumento = Propietario.AutorDocumento?.ToUpper()"
                                          Immediate="true"
                                          For="@(() => Propietario.AutorDocumento)"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudDatePicker Label="Fecha del Documento"
                                           @bind-Date="Propietario.FechaDocumento"
                                           For="@(() => Propietario.FechaDocumento)"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Editable="true" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudNumericField Label="Área Titulada"
                                             @bind-Value="Propietario.AreaTitulada"
                                             For="@(() => Propietario.AreaTitulada)"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             HideSpinButtons="true" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudAutocomplete T="Diccionario"
                                             Label="Unidad de Medida"
                                             Placeholder="Seleccione UDM..."
                                             SearchFunc="SearchUnidadMedida"
                                             Value="selectedUnidadMedida"
                                             ValueChanged="UnidadMedidaChanged"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             ToStringFunc="@(e => e?.Nombre)" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- ================= SECCIÓN 3: DATOS REGISTRALES ================= -->
        <MudItem xs="12">
            <MudCard Elevation="1" Outlined="true" Class="rounded-lg">
                <MudCardHeader Class="pb-2">
                    <CardHeaderContent>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-semibold">Datos Registrales y Fechas</MudText>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Finca"
                                          @bind-Value="Propietario.Finca"
                                          @bind-Value:after="() => Propietario.Finca = Propietario.Finca?.ToUpper()"
                                          Immediate="true"
                                          For="@(() => Propietario.Finca)"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Tomo"
                                          @bind-Value="Propietario.Tomo"
                                          @bind-Value:after="() => Propietario.Tomo = Propietario.Tomo?.ToUpper()"
                                          Immediate="true"
                                          For="@(() => Propietario.Tomo)"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Folio"
                                          @bind-Value="Propietario.Folio"
                                          @bind-Value:after="() => Propietario.Folio = Propietario.Folio?.ToUpper()"
                                          Immediate="true"
                                          For="@(() => Propietario.Folio)"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField Label="Asiento"
                                          @bind-Value="Propietario.Asiento"
                                          @bind-Value:after="() => Propietario.Asiento = Propietario.Asiento?.ToUpper()"
                                          Immediate="true"
                                          For="@(() => Propietario.Asiento)"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Fecha de Adquisición"
                                           @bind-Date="Propietario.FechaAdquisicion"
                                           For="@(() => Propietario.FechaAdquisicion)"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Editable="true" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Fecha de Registro"
                                           @bind-Date="Propietario.FechaRegistro"
                                           For="@(() => Propietario.FechaRegistro)"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Editable="true" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- ================= BOTONES DE ACCIÓN ================= -->
        <MudItem xs="12" Class="d-flex justify-end gap-3 my-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ReturnAction" StartIcon="@Icons.Material.Filled.Cancel">
                Cancelar
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" StartIcon="@Icons.Material.Filled.Save">
                Guardar Propietario
            </MudButton>
        </MudItem>
    </MudGrid>
</EditForm>