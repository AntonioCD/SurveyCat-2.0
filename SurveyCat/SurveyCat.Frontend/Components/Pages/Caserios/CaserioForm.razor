<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />

     <MudItem xs="12" Class="mb-2">
        @* d-flex y justify-space-between empujan el título a la izquierda y el input a la derecha *@
        <div class="d-flex align-center justify-space-between gap-3 pl-1">

            @* BLOQUE IZQUIERDO: Icono + Título y Subtítulo *@
            <div class="d-flex align-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Large" />
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.h5" Color="Color.Primary">
                        <b>@(Caserio?.Id != 0 ? "Editar Caserío" : "Nuevo Caserío")</b>
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Complete los datos requeridos para registrar/editar un Caserío.
                    </MudText>
                </div>
            </div>
        </div>
        <MudDivider Class="mt-3 mb-2" DividerType="DividerType.FullWidth" />
    </MudItem>

    <MudTextField Label="Nombre del Caserio"
                  @bind-Value="@Caserio.Nombre"
                  For="@(() => Caserio.Nombre)"
                  Required="true"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Class="mb-4" />

    <MudGrid Class="align-center mb-4">
        <MudItem xs="12" sm="6">
            <MudTextField Label="Cod. SILEC"
                          @bind-Value="@Caserio.CodCaserio"
                          For="@(() => Caserio.CodCaserio)"
                          Required="true"
                          MaxLength="4"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6" Class="d-flex justify-center">
            <MudSwitch @bind-Value="@Caserio.EsBarrio"
                       Label="@(Caserio.EsBarrio ? "Es un Barrio" : "Es un Caserío")"
                       Color="Color.Primary"
                       ThumbIcon="@(Caserio.EsBarrio? Icons.Material.Filled.LocationCity : Icons.Material.Filled.Landscape)" />
        </MudItem>
    </MudGrid>


    <div class="d-flex justify-end gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ReturnAction">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Guardar</MudButton>
    </div>
</EditForm>
