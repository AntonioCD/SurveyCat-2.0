@page "/municipios/details/{MunicipioId:int}"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@barriosComarcas"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6" Class="mr-4"><i class="bi bi-globe-americas"></i> @municipio?.Nombre</MudText>
            <MudButton Variant="Variant.Outlined" Class="mr-4" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Tertiary" OnClick="ReturnAction">Regresar</MudButton>
            <MudButton Variant="Variant.Outlined" Class="mr-4" EndIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="@(() => ShowModalAsync())">Crear</MudButton>
            <MudSpacer />
            <FilterComponent ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>BarrioComarca</MudTh>
            <MudTh Style="width: 20%;">Cod. SILEC</MudTh>
            <MudTh Style="width: 20%;">Barrio/Comarca</MudTh>
            <MudTh Style="width: 20%;">Caserios</MudTh>
            <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="BarrioComarca">@context.Nombre</MudTd>
            <MudTd DataLabel="Cod. SILEC">@context.CodBarrioComarca</MudTd>
            <MudTd DataLabel="Barrio/Comarca">@(!context.EsBarrio ? "Barrio" : "Comarca")</MudTd>
            <MudTd DataLabel="Caserios">
                @if(context.CaseriosNumber >= 0)
                {
                    <MudTooltip Text="Ver Caserios">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   Size="Size.Medium"
                                   OnClick="@(() => StatesAction(@context))"
                                   Style="width: 70px; min-width: 70px;"
                                   Class="d-flex justify-space-between px-2">

                            <span>@context.CaseriosNumber</span>

                            <MudIcon Icon="@Icons.Material.TwoTone.ArrowCircleRight"
                                     Size="Size.Small"
                                     Class="ml-2" />
                        </MudButton>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: center; white-space: nowrap;">
                <div class="d-flex justify-center">
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       OnClick="@(() => ShowModalAsync(context.Id, true))"
                                       Size="Size.Medium"
                                       Class="mr-2" />
                    </MudTooltip>
                    <MudTooltip Text="Borrar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Filled"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context))"
                                       Size="Size.Medium" />
                    </MudTooltip>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No se encontraron registros.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Numero de Registros:"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todos"
                           InfoFormat="@infoFormat" />
        </PagerContent>
    </MudTable>
}



