<EditForm EditContext="editContext" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <MudTextField Label="Municipio"
                  @bind-Value="@Municipio.Nombre"
                  For="@(() => Municipio.Nombre)"
                  Required="true"
                  Class="mb-4" />
    <MudTextField Label="Cod. SILEC"
                  @bind-Value="@Municipio.CodMun"
                  For="@(() => Municipio.CodMun)"
                  Required="true"
                  Class="mb-4" />
    <MudTextField Label="Cod. INIDE"
                  @bind-Value="@Municipio.CodINIDE"
                  For="@(() => Municipio.CodINIDE)"
                  Class="mb-4" />

    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Color="Color.Info"
               OnClick="ReturnAction">
        <MudHidden xs="true">
            Cancelar
        </MudHidden>
    </MudButton>

    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Check"
               Color="Color.Primary"
               ButtonType="ButtonType.Submit">
        <MudHidden xs="true">
            Guardar
        </MudHidden>
    </MudButton>
</EditForm>