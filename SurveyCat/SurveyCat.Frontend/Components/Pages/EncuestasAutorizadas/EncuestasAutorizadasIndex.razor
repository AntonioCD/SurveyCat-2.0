@page "/encuestasAutorizadas"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@EncuestasAutorizadas"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true">
        <ToolBarContent>
            <div class="d-flex justify-content-between align-items-center gap-2">
                <MudText Typo="Typo.h6" Class="me-4">ENCUESTAS AUTORIZADAS</MudText>
                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Outlined"
                               EndIcon="@Icons.Material.Filled.Add"
                               Color="Color.Info" OnClick="@(() => ShowModalAsync())">
                        Nuevo
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Upload"
                               OnClick="CargaMasiva">
                        Carga Masiva
                    </MudButton>
                </div>
            </div>
            <MudSpacer />
            <FilterComponent @bind-FilterValue="Filter" ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Fecha de Carga</MudTh>
            <MudTh>CodEncuesta</MudTh>
            <MudTh>Tipo Sector</MudTh>
            <MudTh>Municipio</MudTh>
            <MudTh>¿Barrio o Comarca?</MudTh>
            <MudTh>Barrio/Comarca</MudTh>
            <MudTh>Caserío</MudTh>
            <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Fecha de Carga">@context.FechaCarga.ToShortDateString()</MudTd>
            <MudTd DataLabel="Código de Encuesta">@context.CodEncuesta</MudTd>
            <MudTd DataLabel="Sector">@context.TipoSector</MudTd>
            <MudTd DataLabel="Municipio">@context.Municipio?.Nombre</MudTd>
            <MudTd DataLabel="¿Es Barrio?">@(context.BarrioComarca!.EsBarrio ? "Es Barrio" : "Es Comarca") </MudTd>
            <MudTd DataLabel="Barrio/Comarca">@(context.BarrioComarca?.Nombre ?? "SD")</MudTd>
            <MudTd DataLabel="Caserío"> @(context.Caserio?.Nombre ?? "SD")</MudTd>
    
            <MudTd DataLabel="Acciones" Style="text-align: center; white-space: nowrap;">
                <div class="d-flex justify-center">
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       OnClick="@(() => ShowModalAsync(context.Id, true))"
                                       Size="Size.Medium"
                                       Class="mr-2" />
                    </MudTooltip>
                    <MudTooltip Text="Borrar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context))"
                                       Size="Size.Medium" />
                    </MudTooltip>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>"No hay registros"</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat" />
        </PagerContent>
    </MudTable>
}