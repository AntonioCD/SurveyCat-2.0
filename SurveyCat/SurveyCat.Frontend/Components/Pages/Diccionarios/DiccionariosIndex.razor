@page "/diccionarios"

@if (loading)
{
    <Loading />
}
else
{
    <MudTable Items="@Diccionarios"
              @ref="table"
              ServerData="LoadListAsync"
              Dense="true"
              Hover="true"
              Striped="true"
              FixedHeader="true"
              FixedFooter="true"
              @bind-GroupBy="_groupDefinition">
        <ToolBarContent>
            <div class="d-flex justify-content-between">
                <MudText Typo="Typo.h6" Class="me-4">DICCIONARIO</MudText>
                <MudButton Variant="Variant.Outlined"
                           EndIcon="@Icons.Material.Filled.Add"
                           Color="Color.Info" OnClick="@(() => ShowModalAsync())">
                    Nuevo
                </MudButton>
            </div>
            <MudSpacer />
            <FilterComponent @bind-FilterValue="Filter" ApplyFilter="SetFilterValue" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="width: 20%;">Catálogo</MudTh>
            <MudTh Style="width: 39%;">Nombre</MudTh>
            <MudTh Style="width: 20%;">Código</MudTh>
            <MudTh Style="width: 20%;">Activo</MudTh>
            <MudTh Style="width: 1%; white-space: nowrap; text-align: center;">Acciones</MudTh>
        </HeaderContent>

        <GroupHeaderTemplate>
            <MudTh colspan="4">
                <MudText Typo="Typo.subtitle1">
                    <b>Catálogo: @context.Key</b> (@context.Items.Count() registros)
                </MudText>
            </MudTh>
        </GroupHeaderTemplate>

        <RowTemplate>
            <MudTd DataLabel="Catálogo">@context.Catalogo</MudTd>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Código">@context.Codigo</MudTd>
            <MudTd DataLabel="Activo" Style="text-align: left;">
                @if (context.Activo)
                {
                    <MudChip T="string"
                             Variant="Variant.Text"
                             Color="Color.Success"
                             Size="Size.Small">Activo</MudChip>
                }
                else
                {
                    <MudChip T="string"
                             Variant="Variant.Text"
                             Color="Color.Error"
                             Size="Size.Small">Inactivo</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Acciones" Style="text-align: center; white-space: nowrap;">
                <div class="d-flex justify-center">
                    <MudTooltip Text="Editar">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Variant="Variant.Outlined"
                                       Color="Color.Warning"
                                       OnClick="@(() => ShowModalAsync(context.Id, true))"
                                       Size="Size.Medium"
                                       Class="mr-2" />
                    </MudTooltip>
                    <MudTooltip Text="Borrar">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context))"
                                       Size="Size.Medium" />
                    </MudTooltip>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>"No hay registros"</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager RowsPerPageString="Número de registros"
                           PageSizeOptions="pageSizeOptions"
                           AllItemsText="Todo"
                           InfoFormat="@infoFormat" />
        </PagerContent>
    </MudTable>
}

