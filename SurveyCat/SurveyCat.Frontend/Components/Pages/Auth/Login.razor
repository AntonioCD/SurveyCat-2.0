<MudDialog>
    <TitleContent>
        @* Encabezado unificado estilo SurveyCat *@
        <div class="d-flex align-center gap-3 pt-2 px-2">
            <MudIcon Icon="@Icons.Material.Filled.Login" Color="Color.Primary" Size="Size.Large" />
            <div class="d-flex flex-column">
                <MudText Typo="Typo.h6" Color="Color.Primary">
                    <b>Iniciar Sesión</b>
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Ingrese sus credenciales de acceso para gestionar la plataforma.
                </MudText>
            </div>
        </div>
        <MudDivider Class="mt-3 mx-2" DividerType="DividerType.FullWidth" />
    </TitleContent>

    <DialogContent>
        <EditForm Model="loginDTO" OnValidSubmit="LoginAsync" id="loginForm">
            <DataAnnotationsValidator />

            @* pa-2 para evitar colisiones con los extremos del recuadro *@
            <MudGrid Class="pa-2">
                <MudItem xs="12">
                    <MudTextField Label="Usuario"
                                  Variant="Variant.Outlined"
                                  @bind-Value="@loginDTO.Username"
                                  InputType="InputType.Text"
                                  For="@(() => loginDTO.Username)" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField Label="Contraseña"
                                  Variant="Variant.Outlined"
                                  @bind-Value="@loginDTO.Password"
                                  InputType="InputType.Password"
                                  For="@(() => loginDTO.Password)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>

    <DialogActions>
        @* Bloque de control inferior limpio, alineado a la derecha con padding de respiro *@
        <div class="d-flex justify-end gap-2 w-100 px-6 pb-6">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       OnClick="CloseModal"
                       Class="px-6">
                CANCELAR
            </MudButton>

            @* Vinculamos el botón al ID del formulario para que ejecute el OnValidSubmit de forma nativa *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       ButtonType="ButtonType.Submit"
                       Form="loginForm"
                       Class="px-6">
                INICIAR SESIÓN
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>