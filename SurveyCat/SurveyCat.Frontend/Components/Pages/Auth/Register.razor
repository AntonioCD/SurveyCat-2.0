@page "/Register"
@using SurveyCat.Shared.Entities

<MudItem xs="12" Class="mt-2 mb-2">
    @* d-flex y justify-space-between empujan el título a la izquierda y el input a la derecha *@
    <div class="d-flex align-center justify-space-between gap-3 pl-1">

        @* BLOQUE IZQUIERDO: Icono + Título y Subtítulo *@
        <div class="d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Large" />
            <div class="d-flex flex-column">
                <MudText Typo="Typo.h5" Color="Color.Primary">
                    <b>Nuevo Usuario</b>
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Complete los datos requeridos para registrar un nuevo Usuario.
                </MudText>
            </div>
        </div>
    </div>
    <MudDivider Class="mt-3 mb-4" DividerType="DividerType.FullWidth" />
</MudItem>

@if (loading)
{
    <Loading />
}
else
{
    <EditForm Model="userDTO"
              OnValidSubmit="CreateUserAsync"
              OnInvalidSubmit="InvalidForm"
              FormName="RegisterForm">
        <DataAnnotationsValidator />

        @* pa-4 asegura el padding general uniforme del formulario *@
        <MudGrid Class="pa-4">

            @* Autocomplete con variante Outlined *@
            <MudItem xs="12">
                <MudAutocomplete T="PersonalEncuesta"
                                 Label="Personal"
                                 Variant="Variant.Outlined"
                                 Placeholder="--Seleccione un Personal--"
                                 SearchFunc="SearchPersonalEncuestas"
                                 Value="selectedPersonalEncuesta"
                                 ValueChanged="PersonalEncuestaChanged"
                                 ToStringFunc="@(e=> e.Persona==null ? null : $"{e.Persona!.NombreCompleto}")">
                    <ItemTemplate Context="itemContext">
                        @itemContext.Persona!.NombreCompleto
                    </ItemTemplate>
                </MudAutocomplete>
            </MudItem>

            @* Contraseña con variante Outlined *@
            <MudItem xs="12" sm="6">
                <MudTextField Label="Contraseña"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              @bind-Value="userDTO.Password"
                              For="@(() => userDTO.Password)" />
            </MudItem>

            @* Confirmar Contraseña con variante Outlined *@
            <MudItem xs="12" sm="6">
                <MudTextField Label="Confirmar Contraseña"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              @bind-Value="userDTO.PasswordConfirm"
                              For="@(() => userDTO.PasswordConfirm)" />
            </MudItem>

            @* Botones con colores e identificadores consistentes con la paleta activa *@
            <MudItem xs="12" class="d-flex justify-end gap-2 mt-6">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           OnClick="ReturnAction"
                           Class="px-6">
                    CANCELAR
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           ButtonType="ButtonType.Submit"
                           Class="px-6">
                    GUARDAR
                </MudButton>
            </MudItem>
        </MudGrid>
    </EditForm>
}
