@page "/EditUser"
@using SurveyCat.Shared.Entities

<MudItem xs="12" Class="mt-2 mb-2">
    @* BLOQUE DE ENCABEZADO: Mismo diseño limpio que los demás formularios *@
    <div class="d-flex align-center justify-space-between gap-3 pl-1">
        <div class="d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Large" />
            <div class="d-flex flex-column">
                <MudText Typo="Typo.h5" Color="Color.Primary">
                    <b>Editar Usuario</b>
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Modifique los parámetros o el estado de acceso del usuario seleccionado.
                </MudText>
            </div>
        </div>
    </div>
    <MudDivider Class="mt-3 mb-4" DividerType="DividerType.FullWidth" />
</MudItem>

@if (loading)
{
    <Loading />
}
else
{
    <EditForm Model="user" OnValidSubmit="SaveUserAsync">
        <DataAnnotationsValidator />

        @* pa-4 para el padding general uniforme sin contenedores flotantes *@
        <MudGrid Class="pa-4">

            @* Nombre Completo (Lectura) *@
            <MudItem xs="12">
                <MudTextField Label="Nombre Completo"
                              Variant="Variant.Filled"
                              @bind-Value="user!.PersonalEncuesta!.Persona!.NombreCompleto"
                              ReadOnly="true"
                              HelperText="Datos provenientes del registro de Persona" />
            </MudItem>

            @* Código (Lectura) *@
            <MudItem xs="12" sm="6">
                <MudTextField Label="Código"
                              Variant="Variant.Filled"
                              @bind-Value="user!.PersonalEncuesta!.Codigo"
                              ReadOnly="true"
                              HelperText="Datos provenientes de Personal Encuesta" />
            </MudItem>

            @* Brigada (Lectura) *@
            <MudItem xs="12" sm="6">
                <MudTextField Label="Brigada"
                              Variant="Variant.Filled"
                              @bind-Value="user!.PersonalEncuesta!.Brigada"
                              ReadOnly="true" 
                              HelperText="Datos provenientes de Personal Encuesta" />
            </MudItem>

            @* Checkbox alineado limpiamente de forma horizontal *@
            <MudItem xs="12" Class="mt-2">
                <MudCheckBox Label="Usuario Activo"
                             @bind-Value="user!.Activo"
                             Color="Color.Primary"
                             For="@(() => user!.Activo)" />
            </MudItem>

            @* BOTONERA: Alineada a la derecha, sin botones gigantes superpuestos *@
            @* BOTONERA: Alineada a la derecha, limpia y consistente *@
            <MudItem xs="12" Class="d-flex justify-end gap-2 mt-6">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="ReturnAction"
                           Class="px-6">
                    CANCELAR
                </MudButton>

               @*  <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           StartIcon="@Icons.Material.Filled.LockReset"
                           OnClick="ShowModal"
                           Class="px-6">
                    CAMBIAR CONTRASEÑA
                </MudButton> *@

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           ButtonType="ButtonType.Submit"
                           Class="px-6">
                    GUARDAR
                </MudButton>

            </MudItem>
        </MudGrid>
    </EditForm>
}