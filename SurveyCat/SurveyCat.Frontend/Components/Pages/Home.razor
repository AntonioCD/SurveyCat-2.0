@page "/"

<PageTitle>Inicio - SurveyCat</PageTitle>

<AuthorizeView Roles="Administrador">
    <Authorized>
        <div class="d-flex align-center justify-space-between mb-6">
            <div>
                <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Resumen general del sistema catastral SurveyCat.</MudText>
            </div>
            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.CheckCircle">Sistema En Línea</MudChip>
        </div>

        @* SECCIÓN 1: Tarjetas de Resumen Modernizadas *@
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="3" Class="pa-4 d-flex align-center rounded-lg border-l-4 border-solid mud-border-primary">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Large" Class="mr-4">
                        <MudIcon Icon="@Icons.Material.Filled.Description" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h5" Class="font-weight-bold">1,245</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Fichas Registradas</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="3" Class="pa-4 d-flex align-center rounded-lg border-l-4 border-solid mud-border-secondary">
                    <MudAvatar Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Large" Class="mr-4">
                        <MudIcon Icon="@Icons.Material.Filled.People" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h5" Class="font-weight-bold">3,890</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Propietarios</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="3" Class="pa-4 d-flex align-center rounded-lg border-l-4 border-solid mud-border-info">
                    <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Size="Size.Large" Class="mr-4">
                        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h5" Class="font-weight-bold">24</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Personal Activo</MudText>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Elevation="3" Class="pa-4 d-flex align-center rounded-lg border-l-4 border-solid mud-border-success">
                    <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Large" Class="mr-4">
                        <MudIcon Icon="@Icons.Material.Filled.Map" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h5" Class="font-weight-bold">5</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Departamentos</MudText>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @* SECCIÓN 2: Gráficos y Accesos Rápidos *@
        <MudGrid Class="mb-4">
            <MudItem xs="12" md="8">
                <MudPaper Elevation="3" Class="pa-5 rounded-lg" Style="height: 100%;">
                    <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">Fichas Levantadas (Últimos 6 meses)</MudText>
                    <MudChart ChartType="ChartType.Bar" ChartSeries="@Series" XAxisLabels="@XAxisLabels" Width="100%" Height="300px" />
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudPaper Elevation="3" Class="pa-5 rounded-lg d-flex flex-column" Style="height: 100%;">
                    <MudText Typo="Typo.h6" Class="mb-4 font-weight-bold">Accesos Rápidos</MudText>
                    
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Add" FullWidth="true" Class="mb-4 rounded-lg py-3 shadow-md">
                        Nueva Ficha Catastral
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Large" StartIcon="@Icons.Material.Filled.PersonAdd" FullWidth="true" Class="mb-4 rounded-lg py-3 shadow-sm">
                        Registrar Propietario
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Large" StartIcon="@Icons.Material.Filled.AssignmentInd" FullWidth="true" Class="mb-auto rounded-lg py-3 border-solid border-2">
                        Asignar Personal
                    </MudButton>

                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" Class="mr-2"/>
                        Actualizado hace unos instantes
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @* SECCIÓN 3: Actividad Reciente (Llena el espacio en blanco inferior) *@
        <MudGrid>
            <MudItem xs="12">
                <MudTable Items="@ActividadReciente" Elevation="3" Class="rounded-lg" Hover="true" Breakpoint="Breakpoint.Sm">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Últimas Fichas Registradas</MudText>
                        <MudSpacer />
                        <MudButton Color="Color.Primary" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward">Ver todas</MudButton>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Código Ficha</MudTh>
                        <MudTh>Propietario</MudTh>
                        <MudTh>Departamento</MudTh>
                        <MudTh>Fecha de Registro</MudTh>
                        <MudTh>Estado</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="fila">
                        <MudTd DataLabel="Código"><strong>@fila.Codigo</strong></MudTd>
                        <MudTd DataLabel="Propietario">@fila.Propietario</MudTd>
                        <MudTd DataLabel="Departamento">@fila.Departamento</MudTd>
                        <MudTd DataLabel="Fecha">@fila.Fecha</MudTd>
                        <MudTd DataLabel="Estado">
                            <MudChip T="string" Color="@(fila.Estado == "Completada" ? Color.Success : Color.Warning)" Size="Size.Small" Variant="Variant.Filled">
                                @fila.Estado
                            </MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudItem>
        </MudGrid>
    </Authorized>

    <NotAuthorized>
        <div class="d-flex flex-column align-center justify-center" style="height: 70vh;">
            <MudIcon Icon="@Icons.Material.Filled.LockPerson" Color="Color.Primary" Style="font-size: 6rem;" Class="mb-4" />
            <MudText Typo="Typo.h3" Class="mb-2 font-weight-bold">SurveyCat</MudText>
            <MudText Typo="Typo.h6" Class="mud-text-secondary mb-6">Sistema de Gestión Catastral</MudText>
            <MudText Typo="Typo.body1">No estás autenticado. Por favor, inicia sesión para acceder al sistema.</MudText>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    // Datos simulados para el gráfico de barras
    public List<ChartSeries> Series = new List<ChartSeries>()
    {
        new ChartSeries() { Name = "Fichas Nuevas", Data = new double[] { 40, 75, 60, 95, 120, 110 } }
    };
    public string[] XAxisLabels = { "Ene", "Feb", "Mar", "Abr", "May", "Jun" };

    // Clase y datos simulados para la tabla inferior
    public class RegistroFicha
    {
        public string Codigo { get; set; } = string.Empty;
        public string Propietario { get; set; } = string.Empty;
        public string Departamento { get; set; } = string.Empty;
        public string Fecha { get; set; } = string.Empty;
        public string Estado { get; set; } = string.Empty;
    }

    public List<RegistroFicha> ActividadReciente = new List<RegistroFicha>
    {
        new RegistroFicha { Codigo = "RUR-0210-001", Propietario = "Mónica Gómez Cristina", Departamento = "Matagalpa", Fecha = "26/06/2026", Estado = "Completada" },
        new RegistroFicha { Codigo = "URB-0345-089", Propietario = "Juan Pérez González", Departamento = "Managua", Fecha = "25/06/2026", Estado = "Pendiente" },
        new RegistroFicha { Codigo = "RUR-0111-234", Propietario = "María Silva Rojas", Departamento = "Estelí", Fecha = "24/06/2026", Estado = "Completada" },
        new RegistroFicha { Codigo = "URB-0992-002", Propietario = "Carlos Ruiz", Departamento = "León", Fecha = "22/06/2026", Estado = "Completada" }
    };
}